<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             x:Class="Terraria_Wiki.Windows.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Terraria_Wiki.Windows/Presentation/Styles/IconResources.axaml" />
        <ResourceInclude Source="avares://Terraria_Wiki.Windows/Presentation/Styles/ThemeResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <fluent:FluentTheme DensityStyle="Compact">
      <fluent:FluentTheme.Palettes>
        <fluent:ColorPaletteResources x:Key="Dark"
            Accent="{StaticResource TerrariaDarkBrandColor}"
            AltHigh="{StaticResource TerrariaDarkSurfaceColor}"
            AltMediumHigh="{StaticResource TerrariaDarkSurfaceAltColor}"
            AltMedium="{StaticResource TerrariaDarkSurfaceAltColor}"
            AltMediumLow="{StaticResource TerrariaDarkSurfaceColor}"
            BaseHigh="{StaticResource TerrariaDarkTextColor}"
            BaseMediumHigh="{StaticResource TerrariaDarkTextColor}"
            BaseMedium="{StaticResource TerrariaDarkTextSecondaryColor}"
            BaseMediumLow="{StaticResource TerrariaDarkTextDisabledColor}"
            BaseLow="{StaticResource TerrariaDarkStrokeColor}"
            ChromeLow="{StaticResource TerrariaDarkBackgroundColor}"
            ChromeMedium="{StaticResource TerrariaDarkSurfaceColor}"
            ChromeMediumLow="{StaticResource TerrariaDarkSurfaceAltColor}"
            ChromeDisabledHigh="{StaticResource TerrariaDarkSurfaceAltColor}"
            ChromeDisabledLow="{StaticResource TerrariaDarkTextDisabledColor}"
            ChromeHigh="{StaticResource TerrariaDarkTextDisabledColor}"
            ChromeGray="{StaticResource TerrariaDarkTextDisabledColor}"
            ChromeWhite="{StaticResource TerrariaDarkTextColor}"
            ErrorText="{StaticResource TerrariaDarkDangerColor}"
            RegionColor="{StaticResource TerrariaDarkSurfaceColor}" />
      </fluent:FluentTheme.Palettes>
    </fluent:FluentTheme>
    <StyleInclude Source="avares://Terraria_Wiki.Windows/Presentation/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
