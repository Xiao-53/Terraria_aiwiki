<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:management="clr-namespace:Terraria_Wiki.Windows.Presentation.Management"
             xmlns:infrastructure="clr-namespace:Terraria_Wiki.Windows.Presentation.Infrastructure"
             x:Class="Terraria_Wiki.Windows.Presentation.Management.WikiManagementView"
             x:DataType="management:WikiManagementViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <Grid ColumnDefinitions="*,Auto" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Ui.DataManagement}" Classes="page-title" />
      </StackPanel>
      <Button Grid.Column="1" Classes="toolbar-action" Command="{Binding RefreshCommand}"
              VerticalAlignment="Center" IsVisible="{Binding IsAvailable}"
              AutomationProperties.Name="{DynamicResource Ui.RefreshWikiDataStatus}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Stretch="Uniform"
                Data="{StaticResource IconRefresh}"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round" />
          <TextBlock Text="{DynamicResource Ui.Refresh}" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
      </Button>
    </Grid>

    <infrastructure:TopNotificationPanel Grid.Row="1" Margin="0,16,0,0" ZIndex="10"
                                         ClipToBounds="True">
      <Border Classes="management-status floating-status"
              MaxWidth="820" HorizontalAlignment="Stretch"
              IsVisible="{Binding Notification.IsVisible}" Opacity="{Binding Notification.Opacity}">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                     VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Ui.DataManagementStatus}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <Button Content="{DynamicResource Ui.Cancel}" Classes="secondary-action"
                    Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}"
                    AutomationProperties.Name="{DynamicResource Ui.CancelCurrentDataOperation}" />
          </StackPanel>
          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Height="3"
                       Minimum="0" Maximum="{Binding ProgressMaximum}"
                       Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}"
                       IsVisible="{Binding IsBusy}" />
        </Grid>
      </Border>
    </infrastructure:TopNotificationPanel>

    <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="20"
                  Margin="0,0,0,24">
        <Border Classes="section-surface">
          <StackPanel Margin="0,20,0,0" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Ui.DatabaseFile}" Classes="section-title" />
              <TextBlock Text="{DynamicResource Ui.ExportTheCurrentWikiSCompleteDataDb}"
                         Classes="page-subtitle" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource Ui.ImportDatabase}" Classes="secondary-action"
                      Command="{Binding ImportCommand}"
                      AutomationProperties.AutomationId="ImportDatabase"
                      AutomationProperties.Name="{DynamicResource Ui.SelectAndCheckWikiDatabaseFile}" />
              <Button Content="{DynamicResource Ui.ExportDatabase}" Classes="primary-action"
                      Command="{Binding ExportCommand}"
                      AutomationProperties.AutomationId="ExportDatabase"
                      AutomationProperties.Name="{DynamicResource Ui.ExportCurrentWikiDatabaseFile}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="10" IsVisible="{Binding IsAvailable}">
          <TextBlock Text="{DynamicResource Ui.WikiDataSources}" Classes="section-title" />
          <ItemsControl ItemsSource="{Binding Wikis}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="management:WikiBookItemViewModel">
                <Button Command="{Binding SelectCommand}" Classes="list-row"
                        AutomationProperties.Name="{DynamicResource Ui.SelectWikiDataSource}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Ui.Current}" Classes="tag" IsVisible="{Binding IsActive}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" Classes="muted"
                                 TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="{Binding InstallStatus}" Classes="tag" />
                      <TextBlock Text="{Binding Id, StringFormat='ID {0}'}" Classes="muted"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="section-surface" IsVisible="{Binding IsAvailable}">
          <StackPanel Margin="0,20,0,0" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding ActiveWikiTitle}" Classes="section-title" />
              <TextBlock Text="{Binding ActiveWikiDescription}" Classes="page-subtitle"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="12">
              <StackPanel>
                <TextBlock Text="{DynamicResource Ui.Pages}" Classes="muted" />
                <TextBlock Text="{Binding PageCountText}" FontSize="18" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{DynamicResource Ui.Redirects}" Classes="muted" />
                <TextBlock Text="{Binding RedirectCountText}" FontSize="18" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Ui.Resources}" Classes="muted" />
                <TextBlock Text="{Binding ResourceCountText}" FontSize="18" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Row="1">
                <TextBlock Text="{DynamicResource Ui.DiskSpace}" Classes="muted" />
                <TextBlock Text="{Binding DataSizeText}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                <TextBlock Text="{DynamicResource Ui.LastUpdated}" Classes="muted" />
                <TextBlock Text="{Binding UpdateTimeText}" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="section-surface" IsVisible="{Binding ShowOnlineDownloadActions}">
          <StackPanel Margin="0,20,0,0" Spacing="12">
            <TextBlock Text="{DynamicResource Ui.DownloadAndUpdate}" Classes="section-title" />
            <Grid ColumnDefinitions="200,*" ColumnSpacing="16" IsVisible="{Binding HasPageData}">
              <Button Content="{DynamicResource Ui.FullWikiUpdate}" Classes="secondary-action"
                      HorizontalAlignment="Left" Command="{Binding FullUpdateCommand}"
                      AutomationProperties.Name="{DynamicResource Ui.FullWikiUpdate}" />
              <TextBlock Grid.Column="1" Text="{DynamicResource Ui.FullWikiUpdateDescription}"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="200,*" ColumnSpacing="16" IsVisible="{Binding HasPageData}">
              <Button Content="{DynamicResource Ui.QuickWikiUpdate}" Classes="primary-action"
                      HorizontalAlignment="Left" Command="{Binding QuickUpdateCommand}"
                      AutomationProperties.Name="{DynamicResource Ui.QuickWikiUpdate}" />
              <TextBlock Grid.Column="1" Text="{DynamicResource Ui.QuickWikiUpdateDescription}"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="200,*" ColumnSpacing="16" IsVisible="{Binding ShowFullDownloadAction}">
              <Button Content="{DynamicResource Ui.FullDownload}" Classes.primary-action="{Binding !HasPageData}"
                      Classes.secondary-action="{Binding HasPageData}"
                      HorizontalAlignment="Left"
                      Command="{Binding DownloadAllCommand}"
                      AutomationProperties.Name="{DynamicResource Ui.DownloadAllWikiPagesImagesAndAudio}" />
              <TextBlock Grid.Column="1"
                         Text="{DynamicResource Ui.AboutGBSlowerDownloadIncludesPagesImagesAudio}"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="200,*" ColumnSpacing="16" IsVisible="{Binding ShowLightDownloadAction}">
              <Button Content="{DynamicResource Ui.LightweightDownload}" Classes.primary-action="{Binding !HasPageData}"
                      Classes.secondary-action="{Binding HasPageData}"
                      HorizontalAlignment="Left"
                      Command="{Binding DownloadPagesCommand}"
                      AutomationProperties.Name="{DynamicResource Ui.LightweightDownloadBasicWikiPagesOnly}" />
              <TextBlock Grid.Column="1"
                         Text="{DynamicResource Ui.AboutMBBasicPagesOnlyWithoutImagesOr}"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="section-surface" IsVisible="{Binding IsAvailable}">
          <StackPanel Margin="0,20,0,0" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Ui.MaintenanceAndRecovery}" Classes="section-title" />
            </StackPanel>
            <WrapPanel ItemWidth="210" ItemHeight="44">
              <Button Content="{DynamicResource Ui.RetryFailedItems2}" Classes="secondary-action" Margin="0,0,8,8"
                      IsVisible="{Binding SupportsOnlineDownload}"
                      Command="{Binding RetryFailuresCommand}" AutomationProperties.Name="{DynamicResource Ui.RetryFailedWikiDownloads}" />
              <Button Content="{DynamicResource Ui.ClearFailureRecords3}" Classes="danger-action" Margin="0,0,8,8"
                      Command="{Binding RequestClearFailuresCommand}" AutomationProperties.Name="{DynamicResource Ui.RequestClearingDownloadFailureRecords}" />
              <Button Content="{DynamicResource Ui.OptimizeDatabase}" Classes="secondary-action" Margin="0,0,8,8"
                      Command="{Binding VacuumCommand}" AutomationProperties.Name="{DynamicResource Ui.OptimizeWikiDatabase}" />
              <Button Content="{DynamicResource Ui.DeleteAllResources2}" Classes="danger-action" Margin="0,0,8,8"
                      Command="{Binding RequestDeleteResourcesCommand}" AutomationProperties.Name="{DynamicResource Ui.RequestDeletingWikiResources}" />
              <Button Content="{DynamicResource Ui.DeleteCurrentWikiData2}" Classes="danger-action" Margin="0,0,8,8"
                      Command="{Binding RequestDeleteWikiDataCommand}" AutomationProperties.Name="{DynamicResource Ui.RequestDeletingCurrentWikiData}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
