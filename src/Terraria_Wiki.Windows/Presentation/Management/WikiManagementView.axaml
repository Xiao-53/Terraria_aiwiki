<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:management="clr-namespace:Terraria_Wiki.Windows.Presentation.Management"
             x:Class="Terraria_Wiki.Windows.Presentation.Management.WikiManagementView"
             x:DataType="management:WikiManagementViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24">
    <Grid ColumnDefinitions="*,Auto" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Text="数据管理" Classes="page-title" />
      </StackPanel>
      <Button Grid.Column="1" Classes="toolbar-action" Command="{Binding RefreshCommand}"
              VerticalAlignment="Center" IsVisible="{Binding IsAvailable}"
              AutomationProperties.Name="刷新 Wiki 数据状态">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Stretch="Uniform"
                Data="{StaticResource IconRefresh}"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round" />
          <TextBlock Text="刷新" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Classes="management-status" Margin="0,16,0,0"
            MaxWidth="820" HorizontalAlignment="Stretch">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   VerticalAlignment="Center" AutomationProperties.Name="数据管理状态" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <Button Content="取消" Classes="secondary-action"
                  Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}"
                  AutomationProperties.Name="取消当前数据操作" />
        </StackPanel>
        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Height="3"
                     Minimum="0" Maximum="{Binding ProgressMaximum}"
                     Value="{Binding ProgressValue}"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                     IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" Margin="0,16,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="20"
                  Margin="0,0,0,24">
        <Border Classes="section-surface">
          <StackPanel Margin="0,20,0,0" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="数据库文件" Classes="section-title" />
              <TextBlock Text="导出当前 Wiki 的完整 data.db；导入前会检查文件，并在确认后覆盖当前 Wiki 数据。"
                         Classes="page-subtitle" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="导入数据库" Classes="secondary-action"
                      Command="{Binding ImportCommand}"
                      AutomationProperties.AutomationId="ImportDatabase"
                      AutomationProperties.Name="选择并检查 Wiki 数据库文件" />
              <Button Content="导出数据库" Classes="primary-action"
                      Command="{Binding ExportCommand}"
                      AutomationProperties.AutomationId="ExportDatabase"
                      AutomationProperties.Name="导出当前 Wiki 数据库文件" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="confirmation-card" IsVisible="{Binding IsConfirmationVisible}"
                AutomationProperties.Name="数据操作确认">
          <Grid RowDefinitions="Auto,Auto,Auto" Margin="20">
            <TextBlock Text="{Binding ConfirmationTitle}" Classes="section-title" />
            <TextBlock Grid.Row="1" Text="{Binding ConfirmationMessage}" TextWrapping="Wrap"
                       Classes="page-subtitle" Margin="0,8,0,0" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button Content="取消" Classes="secondary-action"
                      Command="{Binding CancelConfirmationCommand}"
                      AutomationProperties.Name="取消数据操作确认" />
              <Button Content="{Binding ConfirmationActionText}" Classes="primary-action"
                      IsVisible="{Binding IsStandardConfirmation}"
                      Command="{Binding ConfirmCommand}"
                      AutomationProperties.Name="确认标准数据操作" />
              <Button Content="{Binding ConfirmationActionText}" Classes="danger-action"
                      IsVisible="{Binding IsDangerousConfirmation}"
                      Command="{Binding ConfirmCommand}"
                      AutomationProperties.Name="确认危险数据操作" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Spacing="10" IsVisible="{Binding IsAvailable}">
          <TextBlock Text="Wiki 数据源" Classes="section-title" />
          <ItemsControl ItemsSource="{Binding Wikis}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="management:WikiBookItemViewModel">
                <Button Command="{Binding SelectCommand}" Classes="list-row"
                        AutomationProperties.Name="选择 Wiki 数据源">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="当前" Classes="tag" IsVisible="{Binding IsActive}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" Classes="muted"
                                 TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="{Binding InstallStatus}" Classes="tag" />
                      <TextBlock Text="{Binding Id, StringFormat='ID {0}'}" Classes="muted"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="section-surface" IsVisible="{Binding IsAvailable}">
          <StackPanel Margin="0,20,0,0" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding ActiveWikiTitle}" Classes="section-title" />
              <TextBlock Text="{Binding ActiveWikiDescription}" Classes="page-subtitle"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="12">
              <StackPanel>
                <TextBlock Text="页面" Classes="muted" />
                <TextBlock Text="{Binding PageCountText}" FontSize="18" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="重定向" Classes="muted" />
                <TextBlock Text="{Binding RedirectCountText}" FontSize="18" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="资源" Classes="muted" />
                <TextBlock Text="{Binding ResourceCountText}" FontSize="18" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Row="1">
                <TextBlock Text="占用空间" Classes="muted" />
                <TextBlock Text="{Binding DataSizeText}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                <TextBlock Text="最近更新" Classes="muted" />
                <TextBlock Text="{Binding UpdateTimeText}" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="section-surface" IsVisible="{Binding IsAvailable}">
          <StackPanel Margin="0,20,0,0" Spacing="12">
            <TextBlock Text="下载与更新" Classes="section-title" />
            <Grid ColumnDefinitions="150,*" ColumnSpacing="16" IsVisible="{Binding HasPageData}">
              <Button Content="检查更新" Classes="primary-action"
                      HorizontalAlignment="Left"
                      Command="{Binding UpdateCommand}"
                      AutomationProperties.Name="检查并更新 Wiki 数据" />
              <TextBlock Grid.Column="1" Text="自动检查 Wiki 并更新"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*" ColumnSpacing="16" IsVisible="{Binding ShowFullDownloadAction}">
              <Button Content="全量下载" Classes.primary-action="{Binding !HasPageData}"
                      Classes.secondary-action="{Binding HasPageData}"
                      HorizontalAlignment="Left"
                      Command="{Binding DownloadAllCommand}"
                      AutomationProperties.Name="全量下载 Wiki 页面、图片和音频" />
              <TextBlock Grid.Column="1"
                         Text="约 4 GB，下载速度较慢，包含页面、图片、音频等全部资源"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*" ColumnSpacing="16" IsVisible="{Binding ShowLightDownloadAction}">
              <Button Content="轻量下载" Classes.primary-action="{Binding !HasPageData}"
                      Classes.secondary-action="{Binding HasPageData}"
                      HorizontalAlignment="Left"
                      Command="{Binding DownloadPagesCommand}"
                      AutomationProperties.Name="轻量下载，仅下载基础 Wiki 页面" />
              <TextBlock Grid.Column="1"
                         Text="约 800 MB，只包含基础页面，没有图片和音频"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="section-surface" IsVisible="{Binding IsAvailable}">
          <StackPanel Margin="0,20,0,0" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="维护与恢复" Classes="section-title" />
            </StackPanel>
            <WrapPanel ItemWidth="170" ItemHeight="44">
              <Button Content="重试失败项" Classes="secondary-action" Margin="0,0,8,8"
                      Command="{Binding RetryFailuresCommand}" AutomationProperties.Name="重试 Wiki 下载失败项" />
              <Button Content="清理失败记录" Classes="danger-action" Margin="0,0,8,8"
                      Command="{Binding RequestClearFailuresCommand}" AutomationProperties.Name="请求清理下载失败记录" />
              <Button Content="整理数据库" Classes="secondary-action" Margin="0,0,8,8"
                      Command="{Binding VacuumCommand}" AutomationProperties.Name="整理 Wiki 数据库" />
              <Button Content="删除全部资源" Classes="danger-action" Margin="0,0,8,8"
                      Command="{Binding RequestDeleteResourcesCommand}" AutomationProperties.Name="请求删除 Wiki 资源" />
              <Button Content="删除当前 Wiki 数据" Classes="danger-action" Margin="0,0,8,8"
                      Command="{Binding RequestDeleteWikiDataCommand}" AutomationProperties.Name="请求删除当前 Wiki 数据" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
