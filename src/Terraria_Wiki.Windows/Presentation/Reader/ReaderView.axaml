<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Terraria_Wiki.Windows.Presentation.Shell"
             x:Class="Terraria_Wiki.Windows.Presentation.Reader.ReaderView"
             x:DataType="shell:ShellViewModel">
  <Border Classes="reader-pane" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Classes="reader-header" Padding="6,2"
              Height="48" IsVisible="{Binding !IsWikiSelected}"
              BorderBrush="{DynamicResource TerrariaStrokeBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Button Classes="icon-button" Command="{Binding Reader.BackCommand}"
                  ToolTip.Tip="返回上一页"
                  AutomationProperties.Name="Reader 返回">
            <PathIcon Width="20" Height="20"
                      Data="M 11,3 L 2,12 L 11,21 L 13,19 L 7,13 L 22,13 L 22,11 L 7,11 L 13,5 Z" />
          </Button>
          <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Reader.Title}" FontWeight="SemiBold"
                       FontSize="14" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Reader.Location}" Classes="muted"
                       FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon-button"
                  Command="{Binding Reader.ToggleFavoriteCommand}"
                  ToolTip.Tip="收藏当前 Wiki 页面"
                  AutomationProperties.AutomationId="ReaderFavorite"
                  AutomationProperties.Name="收藏当前 Wiki 页面">
            <Grid Width="21" Height="21">
              <Path Data="M 12,2 L 15.1,8.3 L 22,9.3 L 17,14.2 L 18.2,21 L 12,17.8 L 5.8,21 L 7,14.2 L 2,9.3 L 8.9,8.3 Z"
                    Stroke="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                    StrokeThickness="1.5" Fill="Transparent"
                    IsVisible="{Binding !Reader.IsWikiFavorite}" />
              <Path Data="M 12,2 L 15.1,8.3 L 22,9.3 L 17,14.2 L 18.2,21 L 12,17.8 L 5.8,21 L 7,14.2 L 2,9.3 L 8.9,8.3 Z"
                    Stroke="{DynamicResource TerrariaBrandBrush}"
                    StrokeThickness="1.3" Fill="{DynamicResource TerrariaBrandSoftBrush}"
                    IsVisible="{Binding Reader.IsWikiFavorite}" />
            </Grid>
          </Button>
          <Button Grid.Column="3" Classes="icon-button"
                  Command="{Binding CloseReaderCommand}"
                  IsVisible="{Binding CanCloseReader}"
                  ToolTip.Tip="关闭 Wiki Reader"
                  AutomationProperties.AutomationId="ReaderClose"
                  AutomationProperties.Name="关闭 Reader">
            <Canvas Width="20" Height="20">
              <Path Data="M 4,4 L 16,16 M 16,4 L 4,16"
                    Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                    StrokeThickness="1.6" />
            </Canvas>
          </Button>
        </Grid>
      </Border>
      <NativeWebView x:Name="ViewerWebView" Grid.Row="1"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     AutomationProperties.Name="本地 Wiki Reader" />
      <Border Grid.Row="2" Classes="reader-status" Padding="12,4"
              BorderBrush="{DynamicResource TerrariaStrokeBrush}"
              BorderThickness="0,1,0,0">
        <TextBlock Text="{Binding Reader.StatusMessage}"
                   FontSize="11" Classes="muted"
                   TextTrimming="CharacterEllipsis"
                   AutomationProperties.Name="Reader 状态" />
      </Border>
    </Grid>
  </Border>
</UserControl>
