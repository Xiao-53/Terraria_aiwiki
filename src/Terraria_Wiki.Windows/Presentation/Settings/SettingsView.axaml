<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Terraria_Wiki.Windows.Presentation.Settings"
             xmlns:infrastructure="clr-namespace:Terraria_Wiki.Windows.Presentation.Infrastructure"
             x:Class="Terraria_Wiki.Windows.Presentation.Settings.SettingsView"
             x:DataType="settings:SettingsViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <Grid ColumnDefinitions="*,Auto" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Orientation="Horizontal" Spacing="32"
                  AutomationProperties.Name="{DynamicResource Ui.SettingsTabs}">
        <Button Content="{DynamicResource Ui.GeneralSettings}" Classes="segment-button page-heading" Width="200"
                Classes.selected="{Binding IsGeneralSelected}"
                Command="{Binding SelectGeneralCommand}"
                AutomationProperties.AutomationId="GeneralSettingsTab"
                AutomationProperties.Name="{DynamicResource Ui.GeneralSettings}" />
        <Button Content="{DynamicResource Ui.AIConfiguration}" Classes="segment-button page-heading" Width="200"
                Classes.selected="{Binding IsAiSelected}"
                Command="{Binding SelectAiCommand}"
                AutomationProperties.AutomationId="AiSettingsTab"
                AutomationProperties.Name="{DynamicResource Ui.AIConfiguration}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center" IsVisible="{Binding IsGeneralSelected}">
        <Button Content="{DynamicResource Ui.RetrySaving}" Classes="toolbar-action" Command="{Binding SaveCommand}"
                IsVisible="{Binding CanRetrySave}" AutomationProperties.Name="{DynamicResource Ui.RetrySavingAppSettings}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center" IsVisible="{Binding IsAiSelected}">
        <Button Content="{DynamicResource Ui.SaveConfiguration}" Classes="primary-action compact-action" Command="{Binding Ai.SaveCommand}"
                AutomationProperties.Name="{DynamicResource Ui.SaveAIConfiguration}" MinWidth="96" />
      </StackPanel>
    </Grid>

    <infrastructure:TopNotificationPanel Grid.Row="1" Margin="0,16,0,0" ZIndex="10"
                                         ClipToBounds="True" IsHitTestVisible="False">
      <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="8">
        <StackPanel Spacing="8" IsVisible="{Binding IsGeneralSelected}">
          <Border Classes="management-status floating-status"
                  IsVisible="{Binding Notification.IsVisible}" Opacity="{Binding Notification.Opacity}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                         VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Ui.AppSettingsStatus}" />
              <ProgressBar Grid.Column="1" Width="72" IsIndeterminate="True"
                           IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="management-status floating-status"
                  IsVisible="{Binding Updates.Notification.IsVisible}" Opacity="{Binding Updates.Notification.Opacity}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Updates.StatusMessage}" TextWrapping="Wrap"
                         AutomationProperties.Name="{DynamicResource Ui.AppUpdateStatus}" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Updates.DownloadProgress}"
                           IsVisible="{Binding Updates.IsProgressVisible}"
                           AutomationProperties.Name="{DynamicResource Ui.AppUpdateDownloadProgress}" />
            </StackPanel>
          </Border>
          <Border Classes="management-status floating-status"
                  IsVisible="{Binding Diagnostics.Notification.IsVisible}" Opacity="{Binding Diagnostics.Notification.Opacity}">
            <TextBlock Text="{Binding Diagnostics.StatusMessage}" TextWrapping="Wrap"
                       AutomationProperties.Name="{DynamicResource Ui.DiagnosticLogStatus}" />
          </Border>
        </StackPanel>
        <Border Classes="management-status floating-status" IsVisible="{Binding Ai.HasStatusMessage}"
                Opacity="{Binding Ai.NotificationOpacity}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding Ai.StatusMessage}" TextWrapping="Wrap"
                       VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Ui.AIConfigurationStatus}" />
            <ProgressBar Grid.Column="1" Width="72" IsIndeterminate="True"
                         IsVisible="{Binding Ai.IsBusy}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>
    </infrastructure:TopNotificationPanel>

    <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,0,24">
        <StackPanel Spacing="20" IsVisible="{Binding IsGeneralSelected}">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource Ui.Personalization}" Classes="section-title" />
            <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.InterfaceLanguageLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Ui.InterfaceLanguageContentHint}"
                           Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox Grid.Column="1" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                        Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"
                        IsEnabled="{Binding IsAvailable}" AutomationProperties.AutomationId="InterfaceLanguage"
                        AutomationProperties.Name="{DynamicResource Ui.InterfaceLanguage}">
                <ComboBoxItem Content="简体中文" />
                <ComboBoxItem Content="English (US)" />
              </ComboBox>
            </Grid>
            <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.InteractionAnimations}" FontWeight="SemiBold" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" Classes="setting-toggle"
                            IsChecked="{Binding IsInteractionFeedbackEnabled, Mode=TwoWay}"
                            IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{DynamicResource Ui.InteractionAnimations}" />
            </Grid>
            <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.StartupPage}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Ui.AppliesOnTheNextStartupWithoutPageData}"
                           Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox Grid.Column="1" SelectedIndex="{Binding StartupPageIndex, Mode=TwoWay}"
                        Width="140" HorizontalAlignment="Left" VerticalAlignment="Center"
                        IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{DynamicResource Ui.StartupPage}">
                <ComboBoxItem Content="{DynamicResource Ui.AIChat}" />
                <ComboBoxItem Content="Wiki" />
              </ComboBox>
            </Grid>
            <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.AppTheme}" FontWeight="SemiBold" />
              </StackPanel>
              <ToggleSwitch x:Name="AppThemeToggle" Grid.Column="1" Classes="setting-toggle"
                            IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                            OnContent="{DynamicResource Ui.Dark}" OffContent="{DynamicResource Ui.Light}"
                            IsEnabled="{Binding IsAvailable}"
                            AutomationProperties.AutomationId="AppThemeToggle"
                            AutomationProperties.Name="{DynamicResource Ui.DarkTheme}" />
            </Grid>
            <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.WikiContentTheme}" FontWeight="SemiBold" />
              </StackPanel>
              <ComboBox Grid.Column="1" SelectedIndex="{Binding ContentThemeIndex, Mode=TwoWay}"
                        Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"
                        IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{DynamicResource Ui.WikiContentTheme}">
                <ComboBoxItem Content="{DynamicResource Ui.FollowApp}" />
                <ComboBoxItem Content="{DynamicResource Ui.OriginalWikiStyle}" />
              </ComboBox>
            </Grid>
          </StackPanel>

          <Border Classes="section-surface">
            <StackPanel Margin="0,20,0,0" Spacing="10">
              <TextBlock Text="Quick Ask" Classes="section-title" />
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <TextBlock Text="{DynamicResource Ui.DefaultPage}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" SelectedIndex="{Binding QuickAccess.PageIndex, Mode=TwoWay}"
                          Width="140" HorizontalAlignment="Left" VerticalAlignment="Center"
                          AutomationProperties.Name="{DynamicResource Ui.QuickAskDefaultPage}">
                  <ComboBoxItem Content="AI" />
                  <ComboBoxItem Content="Wiki" />
                </ComboBox>
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <TextBlock Text="{DynamicResource Ui.ShowShortcut}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding QuickAccess.ShowHotkeyLabel}" Classes="toolbar-action"
                        Width="140" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="{Binding !QuickAccess.Busy}"
                        Click="OnRecordShowHotkey" LostFocus="OnRecorderLostFocus"
                        ToolTip.Tip="{DynamicResource Ui.ClickThenPressAShortcutEscCancelsBackspace}"
                        AutomationProperties.Name="{DynamicResource Ui.RecordQuickAskShowShortcut}" />
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <TextBlock Text="{DynamicResource Ui.HideShortcut}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding QuickAccess.HideHotkeyLabel}" Classes="toolbar-action"
                        Width="140" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="{Binding !QuickAccess.Busy}"
                        Click="OnRecordHideHotkey" LostFocus="OnRecorderLostFocus"
                        ToolTip.Tip="{DynamicResource Ui.ClickThenPressAShortcutEscCancelsBackspace}"
                        AutomationProperties.Name="{DynamicResource Ui.RecordQuickAskHideShortcut}" />
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <TextBlock Text="{DynamicResource Ui.CloseMainWindowToTray}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" Classes="setting-toggle" IsChecked="{Binding QuickAccess.CloseToTray, Mode=TwoWay}"
                              AutomationProperties.Name="{DynamicResource Ui.CloseMainWindowToTray}" />
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <TextBlock Text="{DynamicResource Ui.KeepQuickAskOnTop}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" Classes="setting-toggle" IsChecked="{Binding QuickAccess.Topmost, Mode=TwoWay}"
                              AutomationProperties.Name="{DynamicResource Ui.KeepQuickAskOnTop}" />
              </Grid>
              <TextBlock Text="{Binding QuickAccess.Status}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="section-surface">
            <StackPanel Margin="0,20,0,0" Spacing="12">
              <TextBlock Text="{DynamicResource Ui.ReadingAndSearch}" Classes="section-title" />
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.MouseSideButtonsBackForward}" FontWeight="SemiBold" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" Classes="setting-toggle"
                              IsChecked="{Binding IsSideButtonBackEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{DynamicResource Ui.MouseSideButtonsBackForward}" />
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.MaximumSearchResults}" FontWeight="SemiBold" />
                </StackPanel>
                <settings:IntegerSettingUpDown Classes="integer-setting" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Value="{Binding SearchLimit, Mode=TwoWay}"
                               Minimum="1" Maximum="100" Increment="1" FormatString="0"
                               IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{DynamicResource Ui.MaximumSearchResults}" />
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.AISearchCandidates}" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource Ui.LocalWikiCandidatesRetrievedForEachAIQuestion}"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <settings:IntegerSettingUpDown Classes="integer-setting" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Value="{Binding AiSearchLimit, Mode=TwoWay}"
                               Minimum="1" Maximum="100" Increment="1" FormatString="0"
                               IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{DynamicResource Ui.AISearchCandidates}" />
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.PeriodicallyCheckTheFullWiki}" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource Ui.TurningThisOffDisablesPeriodicChecksInitialSync}"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" Classes="setting-toggle" IsChecked="{Binding IsWikiFullScanEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsAvailable}"
                              AutomationProperties.Name="{DynamicResource Ui.PeriodicallyCheckTheFullWiki}" />
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.FullCheckIntervalDays}" FontWeight="SemiBold" />
                </StackPanel>
                <settings:IntegerSettingUpDown Classes="integer-setting" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Value="{Binding WikiFullScanIntervalDays, Mode=TwoWay}"
                               Minimum="1" Increment="1" FormatString="0"
                               IsEnabled="{Binding CanEditWikiFullScanInterval}"
                               AutomationProperties.Name="{DynamicResource Ui.WikiFullCheckIntervalInDays}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="section-surface">
            <StackPanel Margin="0,20,0,0" Spacing="12">
              <TextBlock Text="{DynamicResource Ui.Downloads}" Classes="section-title" />
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.ConcurrentPages}" FontWeight="SemiBold" />
                </StackPanel>
                <settings:IntegerSettingUpDown Classes="integer-setting" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Value="{Binding PageConcurrency, Mode=TwoWay}"
                               Minimum="1" Maximum="3" Increment="1" FormatString="0"
                               IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{DynamicResource Ui.ConcurrentPageDownloads}" />
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.ConcurrentResources}" FontWeight="SemiBold" />
                </StackPanel>
                <settings:IntegerSettingUpDown Classes="integer-setting" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Value="{Binding ResourceConcurrency, Mode=TwoWay}"
                               Minimum="1" Maximum="20" Increment="1" FormatString="0"
                               IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{DynamicResource Ui.ConcurrentResourceDownloads}" />
              </Grid>
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.RetryAttempts}" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource Ui.AllowedRangeZeroDisablesAutomaticRetries}" Classes="muted" />
                </StackPanel>
                <settings:IntegerSettingUpDown Classes="integer-setting" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Value="{Binding RetryAttempts, Mode=TwoWay}"
                               Minimum="0" Maximum="20" Increment="1" FormatString="0"
                               IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{DynamicResource Ui.DownloadRetryAttempts}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="section-surface">
            <StackPanel Margin="0,20,0,0" Spacing="12">
              <TextBlock Text="{DynamicResource Ui.AboutAndUpdates}" Classes="section-title" />
              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.CurrentVersion}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <SelectableTextBlock Text="{Binding Updates.CurrentVersion}"
                                       AutomationProperties.Name="{DynamicResource Ui.CurrentAppVersion}" />
                  <TextBlock Text="{Binding Updates.DistributionKind}" Classes="muted" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Updates.CapabilityMessage}" Classes="muted" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{DynamicResource Ui.CheckForUpdates}" Classes="secondary-action"
                          Command="{Binding Updates.CheckCommand}"
                          AutomationProperties.Name="{DynamicResource Ui.CheckGitHubReleasesForUpdates}" />
                  <Button Content="{DynamicResource Ui.DownloadUpdate}" Classes="secondary-action"
                          Command="{Binding Updates.DownloadCommand}"
                          AutomationProperties.Name="{DynamicResource Ui.DownloadAndVerifyAppUpdate}" />
                  <Button Content="{DynamicResource Ui.Cancel}" Classes="secondary-action"
                          Command="{Binding Updates.CancelCommand}"
                          AutomationProperties.Name="{DynamicResource Ui.CancelAppUpdateOperation}" />
                  <Button Content="{DynamicResource Ui.RestartAndUpdate}" Classes="primary-action"
                          Command="{Binding Updates.RestartCommand}"
                          AutomationProperties.Name="{DynamicResource Ui.SafelyCloseAndApplyUpdate}" />
                  <Button Content="{DynamicResource Ui.OpenReleases}" Classes="secondary-action"
                          Command="{Binding Updates.OpenReleasesCommand}"
                          AutomationProperties.Name="{DynamicResource Ui.OpenGitHubReleasesInBrowser}" />
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{DynamicResource Ui.TheInitialInstallerDoesNotUseCommercialCode}"
                         Classes="muted" TextWrapping="Wrap" />

              <Grid Classes="setting-row" ColumnDefinitions="*,220" ColumnSpacing="24">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui.RuntimeEnvironment}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <SelectableTextBlock Text="{Binding Diagnostics.WindowsStatus}"
                                       AutomationProperties.Name="{DynamicResource Ui.WindowsRuntimeEnvironment}" />
                  <SelectableTextBlock Text="{Binding Diagnostics.WebView2Status}"
                                       AutomationProperties.Name="{DynamicResource Ui.WebViewRuntimeStatus}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Diagnostics.Description}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{DynamicResource Ui.OpenLogFolder}" Classes="secondary-action"
                        Command="{Binding Diagnostics.OpenLogFolderCommand}"
                        IsVisible="{Binding Diagnostics.CanOpenLogFolder}"
                        AutomationProperties.Name="{DynamicResource Ui.OpenLocalDiagnosticLogFolder}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="20" IsVisible="{Binding IsAiSelected}">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource Ui.ModelService}" Classes="section-title" />
            <TextBlock Text="{Binding Ai.ConfigurationError}" Classes="muted" TextWrapping="Wrap" />
            <Grid Classes="setting-row" ColumnDefinitions="*,300" ColumnSpacing="24">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.Provider}" FontWeight="SemiBold" />
              </StackPanel>
              <ComboBox Grid.Column="1" Classes="ai-selector" SelectedIndex="{Binding Ai.ProviderIndex, Mode=TwoWay}"
                        IsEnabled="{Binding Ai.CanEdit}"
                        AutomationProperties.AutomationId="AiProviderSelector"
                        AutomationProperties.Name="{DynamicResource Ui.AIProvider}">
                <ComboBoxItem Content="{DynamicResource Ui.OfficialDeepSeekAPI}" />
                <ComboBoxItem Content="{DynamicResource Ui.CustomOpenAICompatible}" />
              </ComboBox>
            </Grid>

            <Grid Classes="setting-row" ColumnDefinitions="*,300" ColumnSpacing="24"
                  IsVisible="{Binding Ai.IsDeepSeek}">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.OfficialEndpoint}" FontWeight="SemiBold" />
              </StackPanel>
              <SelectableTextBlock Grid.Column="1" Text="https://api.deepseek.com"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   AutomationProperties.Name="{DynamicResource Ui.OfficialDeepSeekEndpoint}" />
            </Grid>

            <Grid Classes="setting-row" ColumnDefinitions="*,300" ColumnSpacing="24"
                  IsVisible="{Binding Ai.IsCustomProvider}">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.Endpoint}" FontWeight="SemiBold" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding Ai.CustomBaseUrl, Mode=TwoWay}"
                       MinHeight="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                       PlaceholderText="https://api.example.com/v1"
                       IsEnabled="{Binding Ai.CanEdit}"
                       AutomationProperties.AutomationId="CustomAiEndpointInput"
                       AutomationProperties.Name="{DynamicResource Ui.CustomAIEndpoint}" />
            </Grid>
            <Grid Classes="setting-row" ColumnDefinitions="*,300" ColumnSpacing="24"
                  IsVisible="{Binding Ai.IsCustomProvider}">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.APIFormat}" FontWeight="SemiBold" />
              </StackPanel>
              <ComboBox Grid.Column="1" SelectedIndex="{Binding Ai.CustomApiIndex, Mode=TwoWay}"
                        IsEnabled="{Binding Ai.CanEdit}" AutomationProperties.Name="{DynamicResource Ui.CustomAPIFormat}">
                <ComboBoxItem Content="Responses API" />
                <ComboBoxItem Content="Chat Completions API" />
              </ComboBox>
            </Grid>

            <Grid Classes="setting-row" ColumnDefinitions="*,300" ColumnSpacing="24">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.ModelName}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Ui.FetchTheServiceSModelListOrEnter}"
                           Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,140" ColumnSpacing="8" RowSpacing="8">
                <ComboBox Classes="ai-selector model-selector"
                          IsEditable="True"
                          Text="{Binding Ai.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Ai.DiscoveredModels}"
                          PlaceholderText="provider-model"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding Ai.CanEdit}"
                          AutomationProperties.AutomationId="AiModelInput"
                          AutomationProperties.Name="{DynamicResource Ui.EnterOrSelectAIModelName}" />
                  <Button Grid.Column="1" Content="{DynamicResource Ui.FetchModels}" VerticalAlignment="Center" Classes="secondary-action compact-action" HorizontalAlignment="Stretch"
                          Command="{Binding Ai.DiscoverModelsCommand}"
                          AutomationProperties.AutomationId="DiscoverAiModels"
                          AutomationProperties.Name="{DynamicResource Ui.FetchAndSaveModelsUsingTheCurrentUnsaved}" />
                  <Button Grid.Row="1" Grid.Column="1" Content="{DynamicResource Ui.TestConnection}" Classes="secondary-action compact-action" HorizontalAlignment="Stretch"
                          Command="{Binding Ai.TestConfigurationCommand}"
                          AutomationProperties.AutomationId="TestAiConfiguration"
                          AutomationProperties.Name="{DynamicResource Ui.TestConnectionUsingTheCurrentUnsavedConfiguration}" />
              </Grid>
            </Grid>

            <Grid Classes="setting-row" ColumnDefinitions="*,300" ColumnSpacing="24">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="API Key" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Ai.CredentialStatus}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8">
                <Grid>
                  <settings:SecretTextBox Text="{Binding Ai.ApiKey, Mode=TwoWay}"
                                          Classes="api-key-input"
                                          PasswordChar="●"
                                          PlaceholderText="{Binding Ai.ApiKeyPlaceholder}"
                                          IsEnabled="{Binding Ai.CanEdit}"
                                          AutomationProperties.AutomationId="AiApiKeyInput"
                                          AutomationProperties.Name="AI API Key"
                                          AutomationProperties.HelpText="{DynamicResource Ui.KeysAreStoredInWindowsCredentialManagerExisting}" />
                  <TextBlock Text="{DynamicResource Ui.Saved}"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TerrariaTextSecondaryBrush}"
                             IsHitTestVisible="False"
                             IsVisible="{Binding Ai.ShowStoredCredentialMask}"
                             AutomationProperties.Name="{DynamicResource Ui.APIKeySavedItsValueIsHidden}" />
                </Grid>
                <Button Content="{DynamicResource Ui.ClearSavedAPIKey}" Classes="secondary-action compact-action"
                        MinWidth="88" HorizontalAlignment="Right"
                        Command="{Binding Ai.ClearCredentialCommand}"
                        IsVisible="{Binding Ai.HasStoredCredential}"
                        ToolTip.Tip="{DynamicResource Ui.DeleteTheKeyFromWindowsCredentialManagerAnd}"
                        AutomationProperties.Name="{DynamicResource Ui.ClearAIAPIKeyInWindowsCredentialManager}" />
              </StackPanel>
            </Grid>

            <Grid Classes="setting-row" ColumnDefinitions="*,300" ColumnSpacing="24">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.ReasoningEffort}" FontWeight="SemiBold" />
              </StackPanel>
              <ComboBox Grid.Column="1" SelectedIndex="{Binding Ai.ReasoningEffortIndex, Mode=TwoWay}"
                        IsEnabled="{Binding Ai.CanEdit}"
                        AutomationProperties.AutomationId="AiReasoningEffort"
                        AutomationProperties.Name="{DynamicResource Ui.AIReasoningEffort}">
                <ComboBoxItem Content="{DynamicResource Ui.ServiceDefault}" />
                <ComboBoxItem Content="{DynamicResource Ui.Off2}" />
                <ComboBoxItem Content="{DynamicResource Ui.Low}" />
                <ComboBoxItem Content="{DynamicResource Ui.High}" />
                <ComboBoxItem Content="{DynamicResource Ui.Maximum}" />
              </ComboBox>
            </Grid>

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Ui.ConnectionInformation}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Ui.YourQuestionUpToTheLatestTurnsOf}"
                           Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
