<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:Terraria_Wiki.Windows.Presentation.Chat"
             xmlns:reader="clr-namespace:Terraria_Wiki.Windows.Presentation.Reader"
             xmlns:shell="clr-namespace:Terraria_Wiki.Windows.Presentation.Shell"
             x:Class="Terraria_Wiki.Windows.Presentation.Shell.ShellView"
             x:DataType="shell:ShellViewModel">
  <Grid ColumnDefinitions="72,*" RowDefinitions="64,*"
        Background="{DynamicResource TerrariaAppBackgroundBrush}">
    <Border Grid.RowSpan="2" Classes="navigation-rail">
      <Grid RowDefinitions="72,*,Auto">
        <Image Source="avares://Terraria_Wiki.Windows/Assets/appicon.ico"
               Width="40" Height="40" Margin="16"
               VerticalAlignment="Top" />

        <StackPanel Grid.Row="1" Spacing="8"
                    HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Command="{Binding NavigateChatCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsChatSelected}"
                  ToolTip.Tip="{DynamicResource Ui.AIChat}"
                  AutomationProperties.Name="{DynamicResource Ui.AIChatNavigation}">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsChatSelected}" />
              <PathIcon Width="20" Height="20" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconChat}" />
              <TextBlock Grid.Row="1" Text="{DynamicResource Ui.Chat}" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Button Command="{Binding NavigateWikiCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsWikiSelected}"
                  ToolTip.Tip="{DynamicResource Ui.WikiSearch}"
                  AutomationProperties.AutomationId="WikiNavigation"
                  AutomationProperties.Name="{DynamicResource Ui.WikiSearchNavigation}">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsWikiSelected}" />
              <PathIcon Width="20" Height="20" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconSearch}" />
              <TextBlock Grid.Row="1" Text="Wiki" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Button Command="{Binding NavigateFavoritesCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsFavoritesSelected}"
                  ToolTip.Tip="{DynamicResource Ui.Favorites}"
                  AutomationProperties.AutomationId="FavoritesNavigation"
                  AutomationProperties.Name="{DynamicResource Ui.FavoritesNavigation}">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsFavoritesSelected}" />
              <PathIcon Width="20" Height="20" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconFavorite}" />
              <TextBlock Grid.Row="1" Text="{DynamicResource Ui.Favorites}" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Button Command="{Binding NavigateLibraryCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsLibrarySelected}"
                  ToolTip.Tip="{DynamicResource Ui.WikiLibrary}"
                  AutomationProperties.AutomationId="LibraryNavigation"
                  AutomationProperties.Name="{DynamicResource Ui.WikiLibraryNavigation}">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsLibrarySelected}" />
              <PathIcon Width="20" Height="20" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconLibrary}" />
              <TextBlock Grid.Row="1" Text="{DynamicResource Ui.Library}" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Button Command="{Binding NavigateManagementCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsManagementSelected}"
                  ToolTip.Tip="{DynamicResource Ui.DataManagement}"
                  AutomationProperties.AutomationId="ManagementNavigation"
                  AutomationProperties.Name="{DynamicResource Ui.DataManagementNavigation}">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsManagementSelected}" />
              <PathIcon Width="20" Height="20" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconData}" />
              <TextBlock Grid.Row="1" Text="{DynamicResource Ui.Data}" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,12"
                    HorizontalAlignment="Center">
          <Button Command="{Binding NavigateSettingsCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsSettingsSelected}"
                  ToolTip.Tip="{DynamicResource Ui.Settings}"
                  AutomationProperties.AutomationId="SettingsNavigation"
                  AutomationProperties.Name="{DynamicResource Ui.SettingsNavigation}">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsSettingsSelected}" />
              <PathIcon Width="20" Height="20" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconSettings}" />
              <TextBlock Grid.Row="1" Text="{DynamicResource Ui.Settings}" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Border Width="8" Height="8" CornerRadius="4"
                  Background="{DynamicResource TerrariaBrandBrush}"
                  ToolTip.Tip="{DynamicResource Ui.LocalWiki}" />
          <TextBlock Text="LOCAL" FontSize="9" Classes="muted"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Classes="top-bar">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0,20,0">
        <StackPanel VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="Terraria AI Wiki" FontSize="20" LineHeight="26"
                     FontWeight="SemiBold" />
        </StackPanel>
        <Grid Grid.Column="1" Grid.ColumnSpan="2"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              Margin="16,0,0,0" ColumnSpacing="4"
              IsVisible="{Binding IsWikiSelected}">
          <Button Classes="icon-button" Command="{Binding GoToWikiHomeCommand}"
                  IsVisible="{Binding !IsWikiHomeActive}"
                  ToolTip.Tip="{DynamicResource Ui.OpenWikiHomePage}"
                  AutomationProperties.AutomationId="WikiHomeNavigation"
                  AutomationProperties.Name="{DynamicResource Ui.WikiHome}">
            <PathIcon Width="20" Height="20"
                      Data="{StaticResource IconHome}" />
          </Button>
          <Button Grid.Column="1" Classes="icon-button"
                  Command="{Binding ReturnToWikiSearchCommand}"
                  IsVisible="{Binding IsWikiReadingActive}"
                  ToolTip.Tip="{DynamicResource Ui.BackToWikiSearchResults}"
                  AutomationProperties.AutomationId="WikiReturnToSearch"
                  AutomationProperties.Name="{DynamicResource Ui.BackToWikiSearchResults}">
            <PathIcon Width="20" Height="20"
                      Data="{StaticResource IconBack}" />
          </Button>
          <Button Grid.Column="2" Classes="icon-button" Command="{Binding Reader.BackCommand}"
                  IsVisible="{Binding IsWikiReadingActive}"
                  ToolTip.Tip="{DynamicResource Ui.BackToPreviousWikiPage}"
                  AutomationProperties.AutomationId="WikiPageBack"
                  AutomationProperties.Name="{DynamicResource Ui.BackToPreviousWikiPage}">
            <PathIcon Width="20" Height="20"
                      Data="{StaticResource IconPreviousPage}" />
          </Button>
          <Button Grid.Column="3" Classes="icon-button"
                  Command="{Binding Reader.ToggleFavoriteCommand}"
                  IsVisible="{Binding IsWikiSurfaceVisible}"
                  ToolTip.Tip="{Binding Reader.FavoriteActionText}"
                  AutomationProperties.AutomationId="WikiHeaderFavorite"
                  AutomationProperties.Name="{Binding Reader.FavoriteActionText}">
            <Grid Width="24" Height="24">
              <Path Data="{StaticResource IconFavorite}"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.5" StrokeJoin="Round" Fill="Transparent"
                    IsVisible="{Binding !Reader.IsWikiFavorite}" />
              <Path Data="{StaticResource IconFavorite}"
                    Stroke="{DynamicResource TerrariaFavoriteBrush}"
                    StrokeThickness="1.5" StrokeJoin="Round" Fill="{DynamicResource TerrariaFavoriteBrush}"
                    IsVisible="{Binding Reader.IsWikiFavorite}" />
            </Grid>
          </Button>
          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBox x:Name="WikiSearchInput"
                     Width="300" MinWidth="180" MaxWidth="300"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Text="{Binding Wiki.Query, Mode=TwoWay}"
                     IsEnabled="{Binding Wiki.IsAvailable}"
                     PlaceholderText="{DynamicResource Ui.EnterKeywordsToSearch}"
                     AutomationProperties.AutomationId="WikiSearchInput"
                     AutomationProperties.Name="{DynamicResource Ui.LocalWikiSearch}" />
            <Button Classes="icon-button"
                    Command="{Binding Wiki.SearchCommand}"
                    ToolTip.Tip="{DynamicResource Ui.SearchLocalWiki}"
                    AutomationProperties.AutomationId="WikiSearchButton"
                    AutomationProperties.Name="{DynamicResource Ui.SearchLocalWiki}">
              <PathIcon Width="20" Height="20"
                        Data="{StaticResource IconSearch}" />
            </Button>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" MaxWidth="560"
                    IsVisible="{Binding !IsWikiSelected}">
          <TextBlock Text="{Binding StartupStatus}" Classes="muted"
                     IsVisible="{Binding HasStartupError}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="{DynamicResource Ui.AppStatus}" />
          <Button Content="{DynamicResource Ui.GetWebView}" Command="{Binding GetWebView2Command}"
                  Classes="secondary-action"
                  IsVisible="{Binding CanGetWebView2}"
                  ToolTip.Tip="{DynamicResource Ui.OpenMicrosoftSOfficialWebViewDownloadPage}"
                  AutomationProperties.AutomationId="GetWebView2"
                  AutomationProperties.Name="{DynamicResource Ui.GetMicrosoftEdgeWebViewRuntime}" />
          <Button Content="{DynamicResource Ui.Retry}" Command="{Binding RetryStartupCommand}"
                  Classes="secondary-action"
                  IsVisible="{Binding CanRetryStartup}"
                  AutomationProperties.Name="{DynamicResource Ui.RetryAppStartup}" />
          <Button Content="{DynamicResource Ui.OpenWiki}" Command="{Binding OpenWikiReaderCommand}"
                  Classes="wiki-preview-button"
                  IsVisible="{Binding IsWikiPreviewVisible}"
                  ToolTip.Tip="{DynamicResource Ui.OpenWikiReader2}"
                  AutomationProperties.AutomationId="WikiPreview"
                  AutomationProperties.Name="{DynamicResource Ui.OpenWikiPreview}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceGrid" Grid.Column="1" Grid.Row="1"
          RowDefinitions="*"
          ColumnDefinitions="*,0,0">
      <Border x:Name="MainSurface" Grid.Row="0" Grid.Column="0" Classes="workspace-surface"
              MinWidth="460" IsVisible="{Binding !IsWikiSurfaceVisible}"
              AutomationProperties.AutomationId="MainSurface">
        <Grid x:Name="MainContent">
          <Grid IsVisible="{Binding IsChatVisible}">
            <chat:ChatView DataContext="{Binding Chat}" />
          </Grid>
          <Grid x:Name="WikiHost" IsVisible="{Binding IsWikiVisible}" />
          <Grid x:Name="FavoritesHost" IsVisible="{Binding IsFavoritesVisible}" />
          <Grid x:Name="LibraryHost" IsVisible="{Binding IsLibraryVisible}" />
          <Grid x:Name="ManagementHost" IsVisible="{Binding IsManagementVisible}" />
          <Grid x:Name="SettingsHost" IsVisible="{Binding IsSettingsVisible}" />
        </Grid>
      </Border>

      <GridSplitter x:Name="ReaderSplitter" Grid.Row="0" Grid.Column="1"
                    Classes="reader-splitter"
                    Width="12" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    KeyboardIncrement="16" DragIncrement="1"
                    IsVisible="{Binding IsReaderInlineVisible}"
                    AutomationProperties.AutomationId="ReaderSplitter"
                    AutomationProperties.Name="{DynamicResource Ui.ResizeConversationAndWikiPanes}" />

      <Border x:Name="OverlayScrim" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
              Background="{DynamicResource TerrariaOverlayScrimBrush}"
              IsVisible="{Binding IsReaderOverlayVisible}"
              PointerPressed="OnOverlayPressed" />
      <reader:ReaderView x:Name="ReaderHost" Grid.Row="0"
                         Grid.Column="2" MinWidth="400"
                         Classes.overlay="{Binding IsReaderOverlayVisible}"
                         IsVisible="{Binding IsReaderVisible}" />
    </Grid>
  </Grid>
</UserControl>
