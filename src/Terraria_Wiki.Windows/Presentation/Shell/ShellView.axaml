<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:Terraria_Wiki.Windows.Presentation.Chat"
             xmlns:favorites="clr-namespace:Terraria_Wiki.Windows.Presentation.Favorites"
             xmlns:library="clr-namespace:Terraria_Wiki.Windows.Presentation.Library"
             xmlns:management="clr-namespace:Terraria_Wiki.Windows.Presentation.Management"
             xmlns:settings="clr-namespace:Terraria_Wiki.Windows.Presentation.Settings"
             xmlns:wiki="clr-namespace:Terraria_Wiki.Windows.Presentation.Wiki"
             xmlns:reader="clr-namespace:Terraria_Wiki.Windows.Presentation.Reader"
             xmlns:shell="clr-namespace:Terraria_Wiki.Windows.Presentation.Shell"
             x:Class="Terraria_Wiki.Windows.Presentation.Shell.ShellView"
             x:DataType="shell:ShellViewModel">
  <Grid ColumnDefinitions="72,*" RowDefinitions="64,*"
        Background="{DynamicResource TerrariaAppBackgroundBrush}">
    <Border Grid.RowSpan="2" Classes="navigation-rail">
      <Grid RowDefinitions="72,*,Auto">
        <Image Source="avares://Terraria_Wiki.Windows/Assets/appicon.ico"
               Width="40" Height="40" Margin="16"
               VerticalAlignment="Top" />

        <StackPanel Grid.Row="1" Spacing="8"
                    HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Command="{Binding NavigateChatCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsChatSelected}"
                  ToolTip.Tip="AI 问答"
                  AutomationProperties.Name="AI 问答导航">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsChatSelected}" />
              <PathIcon Width="21" Height="21" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 2,2 L 10,2 L 10,10 L 2,10 Z M 14,2 L 22,2 L 22,10 L 14,10 Z M 2,14 L 10,14 L 10,22 L 2,22 Z M 14,14 L 22,14 L 22,22 L 14,22 Z" />
              <TextBlock Grid.Row="1" Text="问答" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Button Command="{Binding NavigateFavoritesCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsFavoritesSelected}"
                  ToolTip.Tip="收藏"
                  AutomationProperties.AutomationId="FavoritesNavigation"
                  AutomationProperties.Name="收藏导航">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsFavoritesSelected}" />
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 12,2 L 15.1,8.3 L 22,9.3 L 17,14.2 L 18.2,21 L 12,17.8 L 5.8,21 L 7,14.2 L 2,9.3 L 8.9,8.3 Z" />
              <TextBlock Grid.Row="1" Text="收藏" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Button Command="{Binding NavigateWikiCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsWikiSelected}"
                  ToolTip.Tip="Wiki 搜索"
                  AutomationProperties.AutomationId="WikiNavigation"
                  AutomationProperties.Name="Wiki 搜索导航">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsWikiSelected}" />
              <PathIcon Width="21" Height="21" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 10,3 C 6.13,3 3,6.13 3,10 C 3,13.87 6.13,17 10,17 C 11.57,17 13.02,16.46 14.16,15.57 L 19.29,20.71 L 20.71,19.29 L 15.57,14.16 C 16.46,13.02 17,11.57 17,10 C 17,6.13 13.87,3 10,3 Z M 10,5 C 12.76,5 15,7.24 15,10 C 15,12.76 12.76,15 10,15 C 7.24,15 5,12.76 5,10 C 5,7.24 7.24,5 10,5 Z" />
              <TextBlock Grid.Row="1" Text="Wiki" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Button Command="{Binding NavigateLibraryCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsLibrarySelected}"
                  ToolTip.Tip="Wiki 资料库"
                  AutomationProperties.AutomationId="LibraryNavigation"
                  AutomationProperties.Name="Wiki 资料库导航">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsLibrarySelected}" />
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 4,3 L 11,3 C 13,3 14,4 14,6 L 14,21 C 14,19 13,18 11,18 L 4,18 Z M 20,3 L 13,3 C 11,3 10,4 10,6 L 10,21 C 10,19 11,18 13,18 L 20,18 Z" />
              <TextBlock Grid.Row="1" Text="资料" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Button Command="{Binding NavigateManagementCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsManagementSelected}"
                  ToolTip.Tip="数据管理"
                  AutomationProperties.AutomationId="ManagementNavigation"
                  AutomationProperties.Name="数据管理导航">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsManagementSelected}" />
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 4,4 L 20,4 L 20,9 L 4,9 Z M 4,10 L 20,10 L 20,15 L 4,15 Z M 4,16 L 20,16 L 20,21 L 4,21 Z" />
              <TextBlock Grid.Row="1" Text="数据" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,12"
                    HorizontalAlignment="Center">
          <Button Command="{Binding NavigateSettingsCommand}"
                  Classes="rail-nav"
                  Classes.selected="{Binding IsSettingsSelected}"
                  ToolTip.Tip="设置"
                  AutomationProperties.AutomationId="SettingsNavigation"
                  AutomationProperties.Name="设置导航">
            <Grid RowDefinitions="34,Auto">
              <Border Classes="rail-indicator" HorizontalAlignment="Left"
                      Grid.RowSpan="2" IsVisible="{Binding IsSettingsSelected}" />
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 9,2 L 15,2 L 16,6 L 20,4 L 23,9 L 20,12 L 23,15 L 20,20 L 16,18 L 15,22 L 9,22 L 8,18 L 4,20 L 1,15 L 4,12 L 1,9 L 4,4 L 8,6 Z M 12,8 C 9.8,8 8,9.8 8,12 C 8,14.2 9.8,16 12,16 C 14.2,16 16,14.2 16,12 C 16,9.8 14.2,8 12,8 Z" />
              <TextBlock Grid.Row="1" Text="设置" FontSize="11" LineHeight="14"
                         HorizontalAlignment="Center" />
            </Grid>
          </Button>
          <Border Width="8" Height="8" CornerRadius="4"
                  Background="{DynamicResource TerrariaBrandBrush}"
                  ToolTip.Tip="本地 Wiki" />
          <TextBlock Text="LOCAL" FontSize="9" Classes="muted"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Classes="top-bar">
      <Grid ColumnDefinitions="*,Auto" Margin="24,0,20,0">
        <StackPanel VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="Terraria AI Wiki" FontSize="20" LineHeight="26"
                     FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" MaxWidth="560">
          <TextBlock Text="{Binding StartupStatus}" Classes="muted"
                     IsVisible="{Binding HasStartupError}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="应用状态" />
          <Button Content="获取 WebView2" Command="{Binding GetWebView2Command}"
                  Classes="secondary-action"
                  IsVisible="{Binding CanGetWebView2}"
                  ToolTip.Tip="打开 Microsoft 官方 WebView2 下载页面"
                  AutomationProperties.AutomationId="GetWebView2"
                  AutomationProperties.Name="获取 Microsoft Edge WebView2 Runtime" />
          <Button Content="重试" Command="{Binding RetryStartupCommand}"
                  Classes="secondary-action"
                  IsVisible="{Binding CanRetryStartup}"
                  AutomationProperties.Name="重试应用启动" />
          <Button Content="打开 Wiki" Command="{Binding OpenWikiReaderCommand}"
                  Classes="wiki-preview-button"
                  IsVisible="{Binding IsWikiPreviewVisible}"
                  ToolTip.Tip="打开 Wiki Reader"
                  AutomationProperties.AutomationId="WikiPreview"
                  AutomationProperties.Name="打开 Wiki 预览" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceGrid" Grid.Column="1" Grid.Row="1"
          RowDefinitions="Auto,*"
          ColumnDefinitions="*,0,0">
      <Border x:Name="WikiToolbar" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
              Background="{DynamicResource TerrariaSurfaceBrush}"
              BorderBrush="{DynamicResource TerrariaStrokeBrush}"
              BorderThickness="0,0,0,1"
              IsVisible="{Binding IsWikiSelected}"
              AutomationProperties.AutomationId="WikiToolbar">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="16,8,20,8">
          <Button Classes="toolbar-action" Command="{Binding GoToWikiHomeCommand}"
                  IsVisible="{Binding !IsWikiHomeActive}"
                  ToolTip.Tip="打开 Wiki 首页"
                  AutomationProperties.AutomationId="WikiHomeNavigation"
                  AutomationProperties.Name="Wiki 主页">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="16" Height="16"
                        Data="M 12,3 L 21.5,11.4 L 20,13.1 L 18.5,11.8 L 18.5,21 L 13.5,21 L 13.5,14.5 L 10.5,14.5 L 10.5,21 L 5.5,21 L 5.5,11.8 L 4,13.1 L 2.5,11.4 Z" />
              <TextBlock Text="主页" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="toolbar-action"
                  Command="{Binding ReturnToWikiSearchCommand}"
                  IsVisible="{Binding IsWikiReadingActive}"
                  ToolTip.Tip="返回搜索结果"
                  AutomationProperties.AutomationId="WikiReturnToSearch"
                  AutomationProperties.Name="返回搜索结果">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="16" Height="16"
                        Data="M 11,3 L 2,12 L 11,21 L 13,19 L 7,13 L 22,13 L 22,11 L 7,11 L 13,5 Z" />
              <TextBlock Text="返回搜索" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="2" Text="Terraria Wiki" FontSize="16" LineHeight="22"
                     FontWeight="SemiBold" VerticalAlignment="Center"
                     Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="4" Text="本地搜索" Classes="muted"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="WikiSearchInput" Grid.Column="5" Width="300" VerticalAlignment="Center"
                   Text="{Binding Wiki.Query, Mode=TwoWay}"
                   IsEnabled="{Binding Wiki.IsAvailable}"
                   PlaceholderText="输入关键词搜索…"
                   AutomationProperties.AutomationId="WikiSearchInput"
                   AutomationProperties.Name="Wiki 本地搜索" />
          <Button Grid.Column="6" Classes="icon-button" Margin="8,0,0,0"
                  Command="{Binding Wiki.SearchCommand}"
                  ToolTip.Tip="搜索本地 Wiki"
                  AutomationProperties.AutomationId="WikiSearchButton"
                  AutomationProperties.Name="搜索本地 Wiki">
            <PathIcon Width="18" Height="18"
                      Data="M 10,3 C 6.13,3 3,6.13 3,10 C 3,13.87 6.13,17 10,17 C 11.57,17 13.02,16.46 14.16,15.57 L 19.29,20.71 L 20.71,19.29 L 15.57,14.16 C 16.46,13.02 17,11.57 17,10 C 17,6.13 13.87,3 10,3 Z M 10,5 C 12.76,5 15,7.24 15,10 C 15,12.76 12.76,15 10,15 C 7.24,15 5,12.76 5,10 C 5,7.24 7.24,5 10,5 Z" />
          </Button>
        </Grid>
      </Border>

      <Border x:Name="MainSurface" Grid.Row="1" Grid.Column="0" Classes="workspace-surface"
              MinWidth="460" IsVisible="{Binding !IsWikiSurfaceVisible}"
              AutomationProperties.AutomationId="MainSurface">
        <Grid x:Name="MainContent">
          <Grid IsVisible="{Binding IsChatVisible}">
            <chat:ChatView DataContext="{Binding Chat}" />
          </Grid>
          <Grid IsVisible="{Binding IsWikiVisible}">
            <wiki:WikiView DataContext="{Binding Wiki}"
                           HorizontalAlignment="Stretch" />
          </Grid>
          <Grid IsVisible="{Binding IsFavoritesVisible}">
            <favorites:FavoritesView DataContext="{Binding Favorites}" />
          </Grid>
          <Grid IsVisible="{Binding IsLibraryVisible}">
            <library:WikiLibraryView DataContext="{Binding Library}" />
          </Grid>
          <Grid IsVisible="{Binding IsManagementVisible}">
            <management:WikiManagementView DataContext="{Binding Management}" />
          </Grid>
          <Grid IsVisible="{Binding IsSettingsVisible}">
            <settings:SettingsView DataContext="{Binding Settings}" />
          </Grid>
        </Grid>
      </Border>

      <GridSplitter x:Name="ReaderSplitter" Grid.Row="1" Grid.Column="1"
                    Classes="reader-splitter"
                    Width="12" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    KeyboardIncrement="16" DragIncrement="1"
                    IsVisible="{Binding IsReaderInlineVisible}"
                    AutomationProperties.AutomationId="ReaderSplitter"
                    AutomationProperties.Name="调整对话与 Wiki 宽度" />

      <Border x:Name="OverlayScrim" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
              Background="{DynamicResource TerrariaOverlayScrimBrush}"
              IsVisible="{Binding IsReaderOverlayVisible}"
              PointerPressed="OnOverlayPressed" />
      <reader:ReaderView x:Name="ReaderHost" Grid.Row="1"
                         Grid.Column="2" MinWidth="400"
                         Classes.overlay="{Binding IsReaderOverlayVisible}"
                         IsVisible="{Binding IsReaderVisible}" />
    </Grid>
  </Grid>
</UserControl>
