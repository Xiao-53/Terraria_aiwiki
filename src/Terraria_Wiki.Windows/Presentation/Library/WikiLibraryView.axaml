<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="clr-namespace:Terraria_Wiki.Windows.Presentation.Library"
             x:Class="Terraria_Wiki.Windows.Presentation.Library.WikiLibraryView"
             x:DataType="library:WikiLibraryViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="*,Auto" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Text="Wiki 资料库" Classes="page-title" />
        <TextBlock Text="浏览本地全部页面与最近阅读记录" Classes="page-subtitle" />
      </StackPanel>
      <Button Grid.Column="1" Classes="toolbar-action" Command="{Binding RefreshCommand}"
              VerticalAlignment="Center" AutomationProperties.Name="刷新 Wiki 资料库">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Stretch="Uniform"
                Data="M 20,11 C 20,16 16,20 11,20 C 6,20 2,16 2,11 C 2,6 6,2 11,2 C 14.2,2 17.1,3.7 18.7,6.4 M 18.7,2 L 18.7,6.4 L 14.3,6.4"
                Stroke="{DynamicResource TerrariaBrandBrush}" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round" />
          <TextBlock Text="刷新" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4"
          MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,16,0,0">
      <Button Content="全部页面" Command="{Binding SelectPagesCommand}"
              Classes="segment-button" Classes.selected="{Binding IsPagesSelected}"
              AutomationProperties.Name="查看全部页面" />
      <Button Grid.Column="1" Content="历史记录" Command="{Binding SelectHistoryCommand}"
              Classes="segment-button" Classes.selected="{Binding IsHistorySelected}"
              AutomationProperties.Name="查看历史记录" />
      <Button Grid.Column="2" Content="清空历史" Command="{Binding RequestClearHistoryCommand}"
              Classes="danger-action" IsVisible="{Binding IsHistorySelected}"
              HorizontalAlignment="Right" AutomationProperties.Name="请求清空浏览历史" />
    </Grid>

    <TextBox Grid.Row="2" Text="{Binding Query, Mode=TwoWay}"
             IsEnabled="{Binding IsAvailable}" PlaceholderText="按标题筛选"
             MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,12,0,0"
             AutomationProperties.Name="筛选 Wiki 资料库" />

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="8">
          <ItemsControl ItemsSource="{Binding Pages}" IsVisible="{Binding IsPagesVisible}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="library:WikiPageItemViewModel">
                <Button Command="{Binding OpenCommand}" Classes="list-row"
                        AutomationProperties.Name="打开全部页面条目">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding ModifiedText}"
                               Classes="tag" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding History}" IsVisible="{Binding IsHistoryVisible}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="library:WikiHistoryItemViewModel">
                <StackPanel>
                  <TextBlock Text="{Binding DateLabel}" Classes="eyebrow"
                             Margin="4,12,0,6" IsVisible="{Binding ShowDateHeader}" />
                  <Button Command="{Binding OpenCommand}" Classes="list-row"
                          AutomationProperties.Name="打开历史页面">
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                      <TextBlock Text="{Binding TimeText}" Classes="tag" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}"
                                 FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding IsEmpty}" Margin="20,54" Spacing="8"
                      HorizontalAlignment="Center">
            <TextBlock Text="没有可显示的内容" Classes="section-title"
                       HorizontalAlignment="Center" />
            <TextBlock Text="可调整筛选条件或稍后刷新。" Classes="page-subtitle" />
          </StackPanel>

          <Button Content="继续加载" Command="{Binding LoadMoreCommand}"
                  IsVisible="{Binding CanLoadMore}" HorizontalAlignment="Center"
                  Margin="0,8,0,16" AutomationProperties.Name="继续加载 Wiki 资料库" />
        </StackPanel>
      </ScrollViewer>

      <Border Classes="card confirmation-card" Padding="20" VerticalAlignment="Top"
              IsVisible="{Binding IsClearConfirmationVisible}"
              MaxWidth="520" HorizontalAlignment="Center" Margin="16,18">
        <StackPanel Spacing="12">
          <TextBlock Text="确定清空全部浏览历史吗？" Classes="section-title" TextWrapping="Wrap" />
          <TextBlock Text="此操作只删除历史记录，不会删除 Wiki 页面或收藏。"
                     Classes="page-subtitle" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消" Command="{Binding CancelClearHistoryCommand}"
                    AutomationProperties.Name="取消清空浏览历史" />
            <Button Content="确认清空" Command="{Binding ConfirmClearHistoryCommand}"
                    Classes="primary-action" AutomationProperties.Name="确认清空浏览历史" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Classes="muted"
               HorizontalAlignment="Center" Margin="0,10,0,0"
               AutomationProperties.Name="Wiki 资料库状态" />
  </Grid>
</UserControl>
