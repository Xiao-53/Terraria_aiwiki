<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="clr-namespace:Terraria_Wiki.Windows.Presentation.Library"
             x:Class="Terraria_Wiki.Windows.Presentation.Library.WikiLibraryView"
             x:DataType="library:WikiLibraryViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="*,Auto" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Ui.WikiLibrary}" Classes="page-title" />
      </StackPanel>
      <Button Grid.Column="1" Classes="toolbar-action" Command="{Binding RefreshCommand}"
              VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Ui.RefreshWikiLibrary}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Stretch="Uniform"
                Data="{StaticResource IconRefresh}"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round" />
          <TextBlock Text="{DynamicResource Ui.Refresh}" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4"
          MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,16,0,0">
      <Button Content="{DynamicResource Ui.AllPages}" Command="{Binding SelectPagesCommand}"
              Classes="segment-button" Classes.selected="{Binding IsPagesSelected}"
              AutomationProperties.Name="{DynamicResource Ui.ViewAllPages}" />
      <Button Grid.Column="1" Content="{DynamicResource Ui.ConversationHistory}" Command="{Binding SelectHistoryCommand}"
              Classes="segment-button" Classes.selected="{Binding IsHistorySelected}"
              AutomationProperties.Name="{DynamicResource Ui.ViewConversationHistory}" />
      <Button Grid.Column="2" Content="{DynamicResource Ui.ClearUnfavorited}" Command="{Binding RequestClearHistoryCommand}"
              Classes="danger-action" IsVisible="{Binding IsHistorySelected}"
              HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Ui.RequestClearingUnfavoritedConversations}" />
    </Grid>

    <TextBox Grid.Row="2" Text="{Binding Query, Mode=TwoWay}"
             PlaceholderText="{DynamicResource Ui.FilterByTitle}"
             MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,12,0,0"
             AutomationProperties.Name="{DynamicResource Ui.FilterWikiLibrary}" />

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="8">
          <ItemsControl ItemsSource="{Binding Pages}" IsVisible="{Binding IsPagesVisible}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="library:WikiPageItemViewModel">
                <Button Command="{Binding OpenCommand}" Classes="list-row"
                        AutomationProperties.Name="{DynamicResource Ui.OpenPageInLibrary}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Classes="tag" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding History}" IsVisible="{Binding IsHistoryVisible}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="library:ConversationHistoryItemViewModel">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Command="{Binding OpenCommand}" Classes="list-row"
                          AutomationProperties.Name="{DynamicResource Ui.OpenConversationFromHistory}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" Classes="tag"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Classes="icon-button danger-icon" Command="{Binding DeleteCommand}"
                          Margin="8,0,0,0" ToolTip.Tip="{DynamicResource Ui.DeleteConversation2}"
                          AutomationProperties.Name="{DynamicResource Ui.DeleteConversationFromHistory}">
                    <Grid Width="24" Height="24">
                      <Path Data="{StaticResource IconDelete}" Stretch="None"
                            Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                            StrokeLineCap="Round" StrokeJoin="Round" />
                    </Grid>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding IsEmpty}" Margin="20,54" Spacing="8"
                      HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource Ui.NothingToShow}" Classes="section-title" />
            <TextBlock Text="{DynamicResource Ui.AdjustTheFilterOrRefreshLater}" Classes="page-subtitle" />
          </StackPanel>
          <Button Classes="secondary-action" Content="{DynamicResource Ui.LoadMore}" Command="{Binding LoadMoreCommand}"
                  IsVisible="{Binding CanLoadMore}" HorizontalAlignment="Center"
                  AutomationProperties.Name="{DynamicResource Ui.LoadMoreWikiPages}" />
        </StackPanel>
      </ScrollViewer>

    </Grid>

    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Classes="muted"
               HorizontalAlignment="Center" Margin="0,10,0,0"
               AutomationProperties.Name="{DynamicResource Ui.WikiLibraryStatus}" />
  </Grid>
</UserControl>
