<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wiki="clr-namespace:Terraria_Wiki.Windows.Presentation.Wiki"
             x:Class="Terraria_Wiki.Windows.Presentation.Wiki.WikiView"
             x:DataType="wiki:WikiViewModel">
  <Grid RowDefinitions="*,Auto" Margin="24,20,24,12">
    <ListBox ItemsSource="{Binding Results}"
             IsVisible="{Binding HasResults}"
             Background="Transparent"
             BorderThickness="0"
             Padding="0"
             AutomationProperties.Name="Wiki 搜索结果">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="wiki:WikiSearchResultViewModel">
          <Button Command="{Binding OpenCommand}" Classes="list-row"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="打开 Wiki 搜索结果">
            <StackPanel Spacing="3">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding MatchText}"
                           Classes="tag" Margin="8,0,0,0" />
              </Grid>
              <TextBlock Text="{Binding RedirectText}" Classes="muted"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Snippet}" Classes="muted"
                         TextWrapping="Wrap" MaxLines="3" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Classes="muted"
               Margin="4,8,4,0" TextWrapping="Wrap"
               AutomationProperties.Name="Wiki 搜索状态" />
  </Grid>
</UserControl>
