<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:Terraria_Wiki.Windows.Presentation.Markdown"
             xmlns:chat="clr-namespace:Terraria_Wiki.Windows.Presentation.Chat"
             x:Class="Terraria_Wiki.Windows.Presentation.Chat.ChatView"
             x:DataType="chat:ChatViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="24,20,24,8" MaxWidth="800"
          HorizontalAlignment="Stretch">
      <StackPanel Spacing="3">
        <TextBlock Text="{DynamicResource Ui.AIChat}" Classes="page-title" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="icon-button" Command="{Binding ToggleFavoriteCommand}"
                ToolTip.Tip="{Binding FavoriteActionText}" AutomationProperties.AutomationId="ChatFavorite"
                AutomationProperties.Name="{Binding FavoriteActionText}">
          <Grid Width="24" Height="24">
            <Path Data="{StaticResource IconFavorite}"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.5" StrokeJoin="Round" Fill="Transparent" IsVisible="{Binding !IsFavorite}" />
            <Path Data="{StaticResource IconFavorite}"
                  Stroke="{DynamicResource TerrariaFavoriteBrush}" StrokeThickness="1.5" StrokeJoin="Round"
                  Fill="{DynamicResource TerrariaFavoriteBrush}" IsVisible="{Binding IsFavorite}" />
          </Grid>
        </Button>
        <Button Classes="toolbar-action" Command="{Binding NewConversationCommand}"
                Click="OnNewConversationClick" MinHeight="44"
                AutomationProperties.AutomationId="NewConversation"
                AutomationProperties.Name="{DynamicResource Ui.NewConversation}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Width="16" Height="16" Data="{StaticResource IconAdd}"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.8" StrokeLineCap="Round" />
            <TextBlock Text="{DynamicResource Ui.NewConversation}" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <StackPanel IsVisible="{Binding IsEmpty}" MaxWidth="720"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="16" Margin="32">
        <Border Width="64" Height="64" CornerRadius="32"
                Background="{DynamicResource TerrariaBrandSoftBrush}">
          <Canvas Width="34" Height="30">
            <Border Canvas.Left="2" Canvas.Top="1" Width="30" Height="23"
                    BorderBrush="{DynamicResource TerrariaBrandBrush}"
                    BorderThickness="2" CornerRadius="8">
              <TextBlock Text="•••" FontSize="14" LetterSpacing="2"
                         Foreground="{DynamicResource TerrariaBrandBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Path Data="M 10,23 L 10,29 L 18,23"
                  Stroke="{DynamicResource TerrariaBrandBrush}" StrokeThickness="2" />
          </Canvas>
        </Border>
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource Ui.ExploreYourTerrariaWorld}" Classes="section-title" TextAlignment="Center" />
          <TextBlock Text="{DynamicResource Ui.AIReadsYourLocalWikiAndAnswersWith}"
                     Classes="page-subtitle" TextAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Spacing="14" Margin="24,8,24,28">
          <Border Classes="error-card" IsVisible="{Binding IsAiUnavailable}" Padding="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Ui.AICurrentlyUnavailable}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="{DynamicResource Ui.Retry}" Command="{Binding RetryCommand}" Classes="secondary-action"
                        AutomationProperties.Name="{DynamicResource Ui.RetryAI}" />
                <Button Content="{DynamicResource Ui.OpenWiki}" Command="{Binding OpenWikiCommand}" Classes="secondary-action"
                        AutomationProperties.Name="{DynamicResource Ui.OpenWikiReader}" />
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Turns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="chat:ChatTurnViewModel">
                <StackPanel Spacing="12" Margin="0,0,0,16">
                  <Border Background="{DynamicResource TerrariaSurfaceAltBrush}"
                          BorderBrush="{DynamicResource TerrariaStrokeBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource RadiusSurface}" Padding="16"
                          HorizontalAlignment="Stretch">
                    <SelectableTextBlock Text="{Binding Question}" TextWrapping="Wrap"
                                         AutomationProperties.Name="{DynamicResource Ui.UserQuestion}" />
                  </Border>

                  <chat:ChatActivityView />

                  <Border Classes="answer-card" IsVisible="{Binding HasAnswer}" Padding="18">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Ui.AIAnswer}" Classes="eyebrow" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource Ui.Generating}" Classes="muted"
                                   IsVisible="{Binding IsStreamingAnswer}" />
                      </Grid>
                      <md:SafeMarkdownView Document="{Binding AnswerDocument}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="sources-card" IsVisible="{Binding HasSources}" Padding="16">
                    <StackPanel Spacing="10">
                      <TextBlock Text="{DynamicResource Ui.Sources}" FontWeight="SemiBold" FontSize="13" />
                      <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="chat:ChatSourceViewModel">
                            <Button Classes="source-row" Command="{Binding OpenCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,6" AutomationProperties.Name="{DynamicResource Ui.OpenVerifiedWikiSource}">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="›" FontSize="18" Margin="12,0,0,0" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="answer-meta-card" IsVisible="{Binding HasUsage}" Padding="12,9">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{DynamicResource Ui.TokenUsage}" FontWeight="SemiBold" FontSize="11" />
                      <SelectableTextBlock Grid.Column="1" Margin="14,0,0,0" Text="{Binding UsageText}"
                                           Classes="muted" TextWrapping="Wrap" FontSize="11"
                                           AutomationProperties.Name="{DynamicResource Ui.AITokenUsage}" />
                    </Grid>
                  </Border>

                  <TextBlock Text="{Binding StatusMessage}" Classes="muted"
                             IsVisible="{Binding IsTerminalStatusVisible}" TextWrapping="Wrap"
                             AutomationProperties.Name="{DynamicResource Ui.AIStatusForThisTurn}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Classes="composer" Padding="7,6"
            Margin="24,0,24,20" MaxWidth="800" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBox x:Name="QuestionBox" Classes="composer-input"
                 Text="{Binding Question, Mode=TwoWay}" IsReadOnly="{Binding IsQuestionReadOnly}"
                 Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                 FocusAdorner="{x:Null}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="40" MaxHeight="120" VerticalContentAlignment="Center"
                 PlaceholderText="{Binding ComposerPlaceholder}" AutomationProperties.Name="{DynamicResource Ui.AIQuestionInput}" />
        <TextBlock Grid.Row="1" Margin="10,0,0,2" Text="{DynamicResource Ui.EnterToSendShiftEnterForANew}"
                   Classes="muted" FontSize="10" IsVisible="{Binding CanEditQuestion}"
                   AutomationProperties.Name="{DynamicResource Ui.InputShortcutHint}" />
        <Button Grid.Column="1" Grid.RowSpan="2" Classes="send-button"
                VerticalAlignment="Center" IsVisible="{Binding IsSendVisible}"
                Command="{Binding SendCommand}" ToolTip.Tip="{DynamicResource Ui.SendEnter}"
                AutomationProperties.Name="{DynamicResource Ui.SendQuestion}">
          <Grid Width="24" Height="24">
            <Path Data="{StaticResource IconSend}" Stretch="None"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.2"
                  StrokeLineCap="Round" StrokeJoin="Round" />
          </Grid>
        </Button>
        <Button Grid.Column="1" Grid.RowSpan="2" Classes="stop-button"
                VerticalAlignment="Center" IsVisible="{Binding IsStopVisible}"
                Command="{Binding StopCommand}" ToolTip.Tip="{DynamicResource Ui.Stop}"
                AutomationProperties.Name="{DynamicResource Ui.StopAnswer}">
          <Border Width="12" Height="12" CornerRadius="2"
                  Background="{Binding $parent[Button].Foreground}" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
