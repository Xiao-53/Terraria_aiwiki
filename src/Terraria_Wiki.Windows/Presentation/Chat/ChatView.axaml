<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:Terraria_Wiki.Windows.Presentation.Markdown"
             xmlns:chat="clr-namespace:Terraria_Wiki.Windows.Presentation.Chat"
             x:Class="Terraria_Wiki.Windows.Presentation.Chat.ChatView"
             x:DataType="chat:ChatViewModel">
  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,54">
      <Button Grid.Column="1" Classes="icon-button"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,16,0,0"
              Command="{Binding ToggleFavoriteCommand}"
              ToolTip.Tip="收藏当前对话"
              AutomationProperties.AutomationId="ChatFavorite"
              AutomationProperties.Name="收藏当前对话">
        <Grid Width="24" Height="24">
          <Path Data="M 12,2 L 15.1,8.3 L 22,9.3 L 17,14.2 L 18.2,21 L 12,17.8 L 5.8,21 L 7,14.2 L 2,9.3 L 8.9,8.3 Z"
                Stroke="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                StrokeThickness="1.5" Fill="Transparent"
                IsVisible="{Binding !IsFavorite}" />
          <Path Data="M 12,2 L 15.1,8.3 L 22,9.3 L 17,14.2 L 18.2,21 L 12,17.8 L 5.8,21 L 7,14.2 L 2,9.3 L 8.9,8.3 Z"
                Stroke="{DynamicResource TerrariaBrandBrush}"
                StrokeThickness="1.3" Fill="{DynamicResource TerrariaBrandSoftBrush}"
                IsVisible="{Binding IsFavorite}" />
        </Grid>
      </Button>

      <StackPanel IsVisible="{Binding IsEmpty}"
                  Grid.ColumnSpan="2" MaxWidth="720"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="16" Margin="32">
        <Border Width="64" Height="64" CornerRadius="32"
                Background="{DynamicResource TerrariaBrandSoftBrush}">
          <Canvas Width="34" Height="30">
            <Border Canvas.Left="2" Canvas.Top="1" Width="30" Height="23"
                    BorderBrush="{DynamicResource TerrariaBrandBrush}"
                    BorderThickness="2" CornerRadius="8">
              <TextBlock Text="•••" FontSize="14" LetterSpacing="2"
                         Foreground="{DynamicResource TerrariaBrandBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Path Data="M 10,23 L 10,29 L 18,23"
                  Stroke="{DynamicResource TerrariaBrandBrush}"
                  StrokeThickness="2" />
          </Canvas>
        </Border>
        <StackPanel Spacing="6">
          <TextBlock Text="探索你的 Terraria 世界" Classes="page-title"
                     TextAlignment="Center" />
          <TextBlock Text="AI 会查阅本地 Wiki，再给出带来源的回答。"
                     Classes="page-subtitle" TextAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <ScrollViewer Grid.Column="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch"
                    Spacing="16" Margin="24,24,24,116">
          <Border Classes="error-card" IsVisible="{Binding IsAiUnavailable}" Padding="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="AI 当前不可用" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="重试" Command="{Binding RetryCommand}"
                        AutomationProperties.Name="重试 AI" />
                <Button Content="打开 Wiki" Command="{Binding OpenWikiCommand}"
                        AutomationProperties.Name="打开 Wiki 阅读" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="thinking-card" IsVisible="{Binding IsAnswering}" Padding="16">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="30" Height="30" CornerRadius="15"
                        Background="{DynamicResource TerrariaBrandSoftBrush}">
                  <Canvas Width="18" Height="18">
                    <Path Data="M 3,5 L 15,5 L 15,13 L 9,13 L 6,16 L 6,13 L 3,13 Z"
                          Stroke="{DynamicResource TerrariaBrandBrush}" StrokeThickness="1.4" />
                    <Path Data="M 6,9 L 7,9 M 9,9 L 10,9 M 12,9 L 13,9"
                          Stroke="{DynamicResource TerrariaBrandBrush}" StrokeThickness="1.6" />
                  </Canvas>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding ActivityTitle}" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Text="{Binding StatusMessage}" Classes="muted"
                             FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <ProgressBar Height="3" IsIndeterminate="True"
                           Foreground="{DynamicResource TerrariaBrandBrush}" />
              <ItemsControl ItemsSource="{Binding Tools}" IsVisible="{Binding HasTools}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="chat:ChatToolProgressViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,4">
                      <Border Width="6" Height="6" CornerRadius="3"
                              Background="{DynamicResource TerrariaBrandBrush}"
                              VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                 FontSize="12" Margin="9,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Status}"
                                 Classes="muted" FontSize="11" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="answer-card" IsVisible="{Binding HasAnswer}" Padding="18">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <Border Classes="answer-label" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Width="6" Height="6" CornerRadius="3"
                            Background="{DynamicResource TerrariaBrandBrush}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="AI 结论" Classes="eyebrow" />
                  </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding IsStreamingAnswer}">
                  <Border Width="6" Height="6" CornerRadius="3"
                          Background="{DynamicResource TerrariaBrandBrush}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="正在生成" Classes="muted" FontSize="11" />
                </StackPanel>
              </Grid>
              <md:SafeMarkdownView Document="{Binding AnswerDocument}" />
            </StackPanel>
          </Border>

          <Border Classes="tool-trace-card" IsVisible="{Binding IsToolTraceVisible}" Padding="14">
            <StackPanel Spacing="7">
              <TextBlock Text="本次查阅" FontWeight="SemiBold" FontSize="12" />
              <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="chat:ChatToolProgressViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="3,2">
                      <TextBlock Text="•" Foreground="{DynamicResource TerrariaBrandBrush}"
                                 FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                 Margin="8,0" FontSize="11" />
                      <TextBlock Grid.Column="2" Text="{Binding Status}"
                                 Classes="muted" FontSize="11" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="sources-card" IsVisible="{Binding HasSources}" Padding="16">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="8" Height="8" CornerRadius="4"
                        Background="{DynamicResource TerrariaBrandBrush}"
                        VerticalAlignment="Center" />
                <TextBlock Text="可信来源" FontWeight="SemiBold" FontSize="13" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="chat:ChatSourceViewModel">
                    <Button Classes="source-row" Command="{Binding OpenCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,6" AutomationProperties.Name="打开可信 Wiki 来源">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Classes="muted"
                                     FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="source-chevron"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="›" FontSize="18"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="answer-meta-card" IsVisible="{Binding HasUsage}" Padding="12,9">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Border Width="7" Height="7" CornerRadius="4"
                        Background="{DynamicResource TerrariaBrandBrush}" />
                <TextBlock Text="Token 花费" FontWeight="SemiBold" FontSize="11" />
              </StackPanel>
              <SelectableTextBlock Grid.Column="1" Margin="14,0,0,0"
                                   Text="{Binding UsageText}" Classes="muted"
                                   TextWrapping="Wrap" FontSize="11"
                                   AutomationProperties.Name="AI Token 花费" />
            </Grid>
          </Border>

          <Border Classes="answer-status" IsVisible="{Binding IsTerminalStatusVisible}"
                  Padding="12,7">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="7" Height="7" CornerRadius="4"
                      Background="{DynamicResource TerrariaBrandBrush}"
                      VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="11"
                         TextWrapping="Wrap" AutomationProperties.Name="AI 状态" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="1" Classes="composer" Padding="7,6"
            Margin="24,0,24,20" MaxWidth="800" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBox x:Name="QuestionBox" Classes="composer-input"
                 Text="{Binding Question, Mode=TwoWay}"
                 IsReadOnly="{Binding IsQuestionReadOnly}"
                 Background="Transparent" BorderBrush="Transparent"
                 BorderThickness="0" FocusAdorner="{x:Null}"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="40" MaxHeight="120"
                 VerticalContentAlignment="Center"
                 PlaceholderText="{Binding ComposerPlaceholder}"
                 AutomationProperties.Name="AI 问题输入" />
        <TextBlock Grid.Row="1" Margin="10,0,0,2"
                   Text="Enter 发送 · Shift+Enter 换行" Classes="muted" FontSize="10"
                   IsVisible="{Binding CanEditQuestion}"
                   AutomationProperties.Name="输入快捷键提示" />
        <Button Grid.Column="1" Grid.RowSpan="2" Classes="send-button"
                VerticalAlignment="Center" IsVisible="{Binding IsSendVisible}"
                Command="{Binding SendCommand}" ToolTip.Tip="发送（Enter）"
                AutomationProperties.Name="发送问题">
          <PathIcon Width="22" Height="22"
                    Data="M 4,3 L 21,12 L 4,21 L 8,13 L 14,12 L 8,11 Z" />
        </Button>
        <Button Grid.Column="1" Grid.RowSpan="2" Classes="stop-button"
                VerticalAlignment="Center" IsVisible="{Binding IsStopVisible}"
                Command="{Binding StopCommand}" ToolTip.Tip="停止"
                AutomationProperties.Name="停止回答">
          <Border Width="12" Height="12" CornerRadius="2"
                  Background="{DynamicResource TerrariaDangerBrush}" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
