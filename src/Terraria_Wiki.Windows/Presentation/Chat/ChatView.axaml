<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:Terraria_Wiki.Windows.Presentation.Markdown"
             xmlns:chat="clr-namespace:Terraria_Wiki.Windows.Presentation.Chat"
             x:Class="Terraria_Wiki.Windows.Presentation.Chat.ChatView"
             x:DataType="chat:ChatViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="24,20,24,8" MaxWidth="800"
          HorizontalAlignment="Stretch">
      <StackPanel Spacing="3">
        <TextBlock Text="AI 问答" Classes="page-title" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="icon-button" Command="{Binding ToggleFavoriteCommand}"
                ToolTip.Tip="收藏整段对话" AutomationProperties.AutomationId="ChatFavorite"
                AutomationProperties.Name="收藏整段对话">
          <Grid Width="24" Height="24">
            <Path Data="M 12,2 L 15.1,8.3 L 22,9.3 L 17,14.2 L 18.2,21 L 12,17.8 L 5.8,21 L 7,14.2 L 2,9.3 L 8.9,8.3 Z"
                  Stroke="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                  StrokeThickness="1.5" Fill="Transparent" IsVisible="{Binding !IsFavorite}" />
            <Path Data="M 12,2 L 15.1,8.3 L 22,9.3 L 17,14.2 L 18.2,21 L 12,17.8 L 5.8,21 L 7,14.2 L 2,9.3 L 8.9,8.3 Z"
                  Stroke="{DynamicResource TerrariaBrandBrush}" StrokeThickness="1.3"
                  Fill="{DynamicResource TerrariaBrandSoftBrush}" IsVisible="{Binding IsFavorite}" />
          </Grid>
        </Button>
        <Button Classes="toolbar-action" Command="{Binding NewConversationCommand}"
                Click="OnNewConversationClick" MinHeight="44"
                AutomationProperties.AutomationId="NewConversation"
                AutomationProperties.Name="新对话">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Width="16" Height="16" Data="M 8,1 L 8,15 M 1,8 L 15,8"
                  Stroke="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                  StrokeThickness="1.8" StrokeLineCap="Round" />
            <TextBlock Text="新对话" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <StackPanel IsVisible="{Binding IsEmpty}" MaxWidth="720"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="16" Margin="32">
        <Border Width="64" Height="64" CornerRadius="32"
                Background="{DynamicResource TerrariaBrandSoftBrush}">
          <Canvas Width="34" Height="30">
            <Border Canvas.Left="2" Canvas.Top="1" Width="30" Height="23"
                    BorderBrush="{DynamicResource TerrariaBrandBrush}"
                    BorderThickness="2" CornerRadius="8">
              <TextBlock Text="•••" FontSize="14" LetterSpacing="2"
                         Foreground="{DynamicResource TerrariaBrandBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Path Data="M 10,23 L 10,29 L 18,23"
                  Stroke="{DynamicResource TerrariaBrandBrush}" StrokeThickness="2" />
          </Canvas>
        </Border>
        <StackPanel Spacing="6">
          <TextBlock Text="探索你的 Terraria 世界" Classes="section-title" TextAlignment="Center" />
          <TextBlock Text="AI 会查阅本地 Wiki，再给出带来源的回答。"
                     Classes="page-subtitle" TextAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Spacing="14" Margin="24,8,24,28">
          <Border Classes="error-card" IsVisible="{Binding IsAiUnavailable}" Padding="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="AI 当前不可用" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="重试" Command="{Binding RetryCommand}" Classes="toolbar-action"
                        AutomationProperties.Name="重试 AI" />
                <Button Content="打开 Wiki" Command="{Binding OpenWikiCommand}" Classes="toolbar-action"
                        AutomationProperties.Name="打开 Wiki 阅读" />
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Turns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="chat:ChatTurnViewModel">
                <StackPanel Spacing="12" Margin="0,0,0,16">
                  <Border Background="{DynamicResource TerrariaSurfaceAltBrush}"
                          BorderBrush="{DynamicResource TerrariaStrokeBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource RadiusSurface}" Padding="16"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6">
                      <TextBlock Text="你" Classes="eyebrow" />
                      <SelectableTextBlock Text="{Binding Question}" TextWrapping="Wrap"
                                           AutomationProperties.Name="用户问题" />
                    </StackPanel>
                  </Border>

                  <Border Classes="thinking-card" IsVisible="{Binding IsAnswering}" Padding="16">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Width="30" Height="30" CornerRadius="15"
                                Background="{DynamicResource TerrariaBrandSoftBrush}">
                          <PathIcon Width="18" Height="18"
                                    Foreground="{DynamicResource TerrariaBrandBrush}"
                                    Data="M 3,5 L 15,5 L 15,13 L 9,13 L 6,16 L 6,13 L 3,13 Z" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                          <TextBlock Text="{Binding ActivityTitle}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                      <ProgressBar Height="3" IsIndeterminate="True"
                                   Foreground="{DynamicResource TerrariaBrandBrush}" />
                      <ItemsControl ItemsSource="{Binding Tools}" IsVisible="{Binding HasTools}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="chat:ChatToolProgressViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                              <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                              <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="11" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="answer-card" IsVisible="{Binding HasAnswer}" Padding="18">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="AI 结论" Classes="eyebrow" />
                        <TextBlock Grid.Column="1" Text="正在生成" Classes="muted"
                                   IsVisible="{Binding IsStreamingAnswer}" />
                      </Grid>
                      <md:SafeMarkdownView Document="{Binding AnswerDocument}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="tool-trace-card" IsVisible="{Binding IsToolTraceVisible}" Padding="14">
                    <StackPanel Spacing="7">
                      <TextBlock Text="本轮查阅" FontWeight="SemiBold" FontSize="12" />
                      <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="chat:ChatToolProgressViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="3,2">
                              <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                              <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="11" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="sources-card" IsVisible="{Binding HasSources}" Padding="16">
                    <StackPanel Spacing="10">
                      <TextBlock Text="可信来源" FontWeight="SemiBold" FontSize="13" />
                      <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="chat:ChatSourceViewModel">
                            <Button Classes="source-row" Command="{Binding OpenCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,6" AutomationProperties.Name="打开可信 Wiki 来源">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="›" FontSize="18" Margin="12,0,0,0" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="answer-meta-card" IsVisible="{Binding HasUsage}" Padding="12,9">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="Token 花费" FontWeight="SemiBold" FontSize="11" />
                      <SelectableTextBlock Grid.Column="1" Margin="14,0,0,0" Text="{Binding UsageText}"
                                           Classes="muted" TextWrapping="Wrap" FontSize="11"
                                           AutomationProperties.Name="AI Token 花费" />
                    </Grid>
                  </Border>

                  <TextBlock Text="{Binding StatusMessage}" Classes="muted"
                             IsVisible="{Binding IsTerminalStatusVisible}" TextWrapping="Wrap"
                             AutomationProperties.Name="本轮 AI 状态" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Classes="composer" Padding="7,6"
            Margin="24,0,24,20" MaxWidth="800" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBox x:Name="QuestionBox" Classes="composer-input"
                 Text="{Binding Question, Mode=TwoWay}" IsReadOnly="{Binding IsQuestionReadOnly}"
                 Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                 FocusAdorner="{x:Null}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="40" MaxHeight="120" VerticalContentAlignment="Center"
                 PlaceholderText="{Binding ComposerPlaceholder}" AutomationProperties.Name="AI 问题输入" />
        <TextBlock Grid.Row="1" Margin="10,0,0,2" Text="Enter 发送 · Shift+Enter 换行"
                   Classes="muted" FontSize="10" IsVisible="{Binding CanEditQuestion}"
                   AutomationProperties.Name="输入快捷键提示" />
        <Button Grid.Column="1" Grid.RowSpan="2" Classes="send-button"
                VerticalAlignment="Center" IsVisible="{Binding IsSendVisible}"
                Command="{Binding SendCommand}" ToolTip.Tip="发送（Enter）"
                AutomationProperties.Name="发送问题">
          <PathIcon Width="22" Height="22" Data="M 4,3 L 21,12 L 4,21 L 8,13 L 14,12 L 8,11 Z" />
        </Button>
        <Button Grid.Column="1" Grid.RowSpan="2" Classes="stop-button"
                VerticalAlignment="Center" IsVisible="{Binding IsStopVisible}"
                Command="{Binding StopCommand}" ToolTip.Tip="停止"
                AutomationProperties.Name="停止回答">
          <Border Width="12" Height="12" CornerRadius="2"
                  Background="{DynamicResource TerrariaDangerBrush}" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
