<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:favorites="clr-namespace:Terraria_Wiki.Windows.Presentation.Favorites"
             x:Class="Terraria_Wiki.Windows.Presentation.Favorites.FavoritesView"
             x:DataType="favorites:FavoritesViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <Grid ColumnDefinitions="*,Auto" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Ui.Favorites}" Classes="page-title" />
      </StackPanel>
      <Button Grid.Column="1" Classes="toolbar-action" Command="{Binding RefreshCommand}"
              VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Ui.RefreshFavorites}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Stretch="Uniform"
                Data="{StaticResource IconRefresh}"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round" />
          <TextBlock Text="{DynamicResource Ui.Refresh}" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,20,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="24" MaxWidth="820" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Text="{DynamicResource Ui.FavoriteConversations}" Classes="section-title" />
            <TextBlock Grid.Column="1" Text="{Binding ChatFavoriteCountText}"
                       Classes="tag" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{Binding ChatFavorites}" IsVisible="{Binding HasChatFavorites}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="favorites:ChatFavoriteItemViewModel">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Command="{Binding OpenCommand}" Classes="list-row"
                          AutomationProperties.Name="{DynamicResource Ui.OpenFavoriteConversation}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Question}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Preview}" Classes="muted" TextWrapping="Wrap" MaxLines="2" />
                      <TextBlock Text="{Binding TimeText}" Classes="tag" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Classes="icon-button" Command="{Binding RemoveCommand}"
                          Margin="8,0,0,0" VerticalAlignment="Center"
                          ToolTip.Tip="{DynamicResource Ui.Unfavorite}" AutomationProperties.Name="{DynamicResource Ui.UnfavoriteConversation}">
                    <Path Width="20" Height="20" Data="{StaticResource IconClose}"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{DynamicResource Ui.FavoriteAConversationInAIChatToSee}"
                     Classes="muted" Margin="0,8" IsVisible="{Binding !HasChatFavorites}" />
        </StackPanel>

        <Border Classes="section-surface" Padding="0,20,0,0">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
              <TextBlock Text="{DynamicResource Ui.WikiFavorites}" Classes="section-title" />
              <TextBlock Grid.Column="1" Text="{Binding WikiFavoriteCountText}"
                         Classes="tag" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding WikiFavorites}" IsVisible="{Binding HasWikiFavorites}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="favorites:WikiFavoriteItemViewModel">
                  <Grid ColumnDefinitions="*,Auto">
                    <Button Command="{Binding OpenCommand}" Classes="list-row"
                            AutomationProperties.Name="{DynamicResource Ui.OpenWikiFavorite}">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WikiTitle}" Classes="muted" />
                        <TextBlock Text="{Binding TimeText}" Classes="tag" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="icon-button" Command="{Binding RemoveCommand}"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Ui.Unfavorite}" AutomationProperties.Name="{DynamicResource Ui.UnfavoriteWikiPage}">
                      <Path Width="20" Height="20" Data="{StaticResource IconClose}"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{DynamicResource Ui.ClickTheStarInTheReaderTitleBar}"
                       Classes="muted" Margin="0,8" IsVisible="{Binding !HasWikiFavorites}" />
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Classes="muted"
                   HorizontalAlignment="Center" Margin="0,0,0,12"
                   AutomationProperties.Name="{DynamicResource Ui.FavoritesStatus}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
