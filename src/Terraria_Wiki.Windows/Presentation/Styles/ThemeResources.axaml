<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared by the Dark brushes, Fluent palette and native window chrome. -->
  <Color x:Key="TerrariaDarkBrandColor">#FFA7BE82</Color>
  <Color x:Key="TerrariaDarkBackgroundColor">#FF181A18</Color>
  <Color x:Key="TerrariaDarkNavigationColor">#FF1D201D</Color>
  <Color x:Key="TerrariaDarkSurfaceColor">#FF232723</Color>
  <Color x:Key="TerrariaDarkSurfaceAltColor">#FF2D322C</Color>
  <Color x:Key="TerrariaDarkStrokeColor">#FF414841</Color>
  <Color x:Key="TerrariaDarkTextColor">#FFE7EBE3</Color>
  <Color x:Key="TerrariaDarkTextSecondaryColor">#FFAEB7A7</Color>
  <Color x:Key="TerrariaDarkTextDisabledColor">#FF7A8474</Color>
  <Color x:Key="TerrariaDarkOnBrandColor">#FF1B2412</Color>
  <Color x:Key="TerrariaDarkDangerColor">#FFE38A87</Color>
  <Color x:Key="TerrariaDarkFavoriteColor">#FFE4BA58</Color>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="TerrariaBrandBrush" Color="#5F7F39" />
      <SolidColorBrush x:Key="TerrariaPrimaryHoverBrush" Color="#3D571F" />
      <SolidColorBrush x:Key="TerrariaPrimaryPressedBrush" Color="#2D4314" />
      <SolidColorBrush x:Key="TerrariaBrandSoftBrush" Color="#185F7F39" />
      <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="TerrariaBrandSoftBrush" />
      <SolidColorBrush x:Key="TerrariaBrandHoverBrush" Color="#285F7F39" />
      <SolidColorBrush x:Key="TerrariaBrandPressedBrush" Color="#385F7F39" />
      <SolidColorBrush x:Key="TerrariaOnBrandBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TerrariaAppBackgroundBrush" Color="#FFF5F7F2" />
      <SolidColorBrush x:Key="TerrariaNavigationBrush" Color="#FFFAFCF8" />
      <SolidColorBrush x:Key="TerrariaSurfaceBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TerrariaSurfaceAltBrush" Color="#FFF0F3EC" />
      <SolidColorBrush x:Key="TerrariaStrokeBrush" Color="#2424331A" />
      <SolidColorBrush x:Key="TerrariaTextSecondaryBrush" Color="#FF657060" />
      <SolidColorBrush x:Key="TerrariaDangerBrush" Color="#FFB44943" />
      <SolidColorBrush x:Key="TerrariaDangerHoverBrush" Color="#28B44943" />
      <SolidColorBrush x:Key="TerrariaDangerPressedBrush" Color="#38B44943" />
      <SolidColorBrush x:Key="TerrariaDangerSoftBrush" Color="#18B44943" />
      <SolidColorBrush x:Key="TerrariaFavoriteBrush" Color="#FFD39B00" />
      <SolidColorBrush x:Key="TerrariaOverlayScrimBrush" Color="#66000000" />
      <SolidColorBrush x:Key="TerrariaSendBrush" Color="#5F7F39" />
      <SolidColorBrush x:Key="TerrariaSendHoverBrush" Color="#FF103F2A" />
      <SolidColorBrush x:Key="TerrariaSendPressedBrush" Color="#FF0A3020" />
      <SolidColorBrush x:Key="TerrariaOnSendBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TerrariaButtonOutlineBrush" Color="#FFA5B69A" />
      <SolidColorBrush x:Key="TerrariaActionSurfaceBrush" Color="#FFE6EEDF" />
      <SolidColorBrush x:Key="TerrariaActionHoverBrush" Color="#FFCCDDBD" />
      <SolidColorBrush x:Key="TerrariaActionPressedBrush" Color="#FFB2CAA0" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="TerrariaBrandBrush" Color="{StaticResource TerrariaDarkBrandColor}" />
      <SolidColorBrush x:Key="TerrariaPrimaryHoverBrush" Color="#FFB7CB98" />
      <SolidColorBrush x:Key="TerrariaPrimaryPressedBrush" Color="#FF94AA70" />
      <SolidColorBrush x:Key="TerrariaBrandSoftBrush" Color="#24A7BE82" />
      <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="TerrariaBrandSoftBrush" />
      <SolidColorBrush x:Key="TerrariaBrandHoverBrush" Color="#34A7BE82" />
      <SolidColorBrush x:Key="TerrariaBrandPressedBrush" Color="#48A7BE82" />
      <SolidColorBrush x:Key="TerrariaOnBrandBrush" Color="{StaticResource TerrariaDarkOnBrandColor}" />
      <SolidColorBrush x:Key="TerrariaAppBackgroundBrush" Color="{StaticResource TerrariaDarkBackgroundColor}" />
      <SolidColorBrush x:Key="TerrariaNavigationBrush" Color="{StaticResource TerrariaDarkNavigationColor}" />
      <SolidColorBrush x:Key="TerrariaSurfaceBrush" Color="{StaticResource TerrariaDarkSurfaceColor}" />
      <SolidColorBrush x:Key="TerrariaSurfaceAltBrush" Color="{StaticResource TerrariaDarkSurfaceAltColor}" />
      <SolidColorBrush x:Key="TerrariaStrokeBrush" Color="{StaticResource TerrariaDarkStrokeColor}" />
      <SolidColorBrush x:Key="TerrariaTextSecondaryBrush" Color="{StaticResource TerrariaDarkTextSecondaryColor}" />
      <SolidColorBrush x:Key="TerrariaDangerBrush" Color="{StaticResource TerrariaDarkDangerColor}" />
      <SolidColorBrush x:Key="TerrariaDangerHoverBrush" Color="#34E38A87" />
      <SolidColorBrush x:Key="TerrariaDangerPressedBrush" Color="#48E38A87" />
      <SolidColorBrush x:Key="TerrariaDangerSoftBrush" Color="#24E38A87" />
      <SolidColorBrush x:Key="TerrariaFavoriteBrush" Color="{StaticResource TerrariaDarkFavoriteColor}" />
      <SolidColorBrush x:Key="TerrariaOverlayScrimBrush" Color="#99000000" />
      <StaticResource x:Key="TerrariaSendBrush" ResourceKey="TerrariaBrandBrush" />
      <StaticResource x:Key="TerrariaSendHoverBrush" ResourceKey="TerrariaPrimaryHoverBrush" />
      <StaticResource x:Key="TerrariaSendPressedBrush" ResourceKey="TerrariaPrimaryPressedBrush" />
      <StaticResource x:Key="TerrariaOnSendBrush" ResourceKey="TerrariaOnBrandBrush" />
      <SolidColorBrush x:Key="TerrariaButtonOutlineBrush" Color="#FF55624A" />
      <SolidColorBrush x:Key="TerrariaActionSurfaceBrush" Color="#FF2D3428" />
      <SolidColorBrush x:Key="TerrariaActionHoverBrush" Color="#FF3A4531" />
      <SolidColorBrush x:Key="TerrariaActionPressedBrush" Color="#FF49573B" />
      <StaticResource x:Key="SystemControlHighlightAltChromeWhiteBrush" ResourceKey="TerrariaOnBrandBrush" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Thickness x:Key="PagePadding">24</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="RadiusSurface">12</CornerRadius>
  <CornerRadius x:Key="RadiusPill">18</CornerRadius>
  <BoxShadows x:Key="ComposerShadow">0 6 20 0 #22000000</BoxShadows>
  <BoxShadows x:Key="OverlayShadow">0 12 32 0 #38000000</BoxShadows>

  <ControlTheme x:Key="ChromeLessButtonTheme" TargetType="Button">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter" RecognizesAccessKey="True"
                            Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <Border Name="PART_ButtonUnderline" IsVisible="False" IsHitTestVisible="False"
                Height="2" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}" />
        <Border Name="PART_ButtonFocusRing" IsVisible="False" IsHitTestVisible="False"
                Margin="1" BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}"
                BorderBrush="{DynamicResource TerrariaBrandBrush}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="ReaderSplitterTheme" TargetType="GridSplitter">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Border Name="PART_Handle" Width="2" Height="40" CornerRadius="1"
                  Background="{DynamicResource TerrariaStrokeBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
